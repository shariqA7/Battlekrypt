// ============================================================
// Esports Tournament Platform — Database Schema (PHASE 1 + PHASE 2 CLUB CORE)
// Postgres + Prisma ORM
//
// This is the trimmed, launch-critical subset. The full 9-phase
// schema (Club, Merch, Ratings, Donations, etc.) is preserved in
// schema.full.prisma — copy sections back in as each phase is built,
// rather than migrating everything up front.
//
// Design principles:
// - Money fields ALWAYS store {amount, currency} together
// - JSONB (Json fields) used only for genuinely variable-shape data
//   (organizer custom registration fields)
// - Rules are simple free-text at Phase 1 (structured rules + severity
//   come in Phase 3 — see schema.full.prisma for that version)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// IDENTITY
// ------------------------------------------------------------

enum KycStatus {
  none
  pending
  approved
  rejected
}

model User {
  id          String    @id // matches Supabase auth.users.id — not auto-generated here
  email       String?   @unique
  phone       String?   @unique
  displayName String
  avatarUrl   String?
  kycStatus   KycStatus @default(none) // doubles as the organizer-approval gate in Phase 1
  isAdmin     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playerProfile         PlayerProfile?
  organizerProfile      OrganizerProfile?
  clubProfile           ClubProfile?
  orgApplication        OrganizationApplication?
  orgMemberships        OrganizationMember[]
  bans                  AccountBan[]             @relation("BannedUser")
  nameClaims            ClubNameClaim[]          @relation("ClaimantUser")
  visits                VisitSession[]
  challenges            Challenge[]              @relation("ChallengePoster")
  challengeApplications ChallengeApplication[]   @relation("ChallengeApplicant")
  notifications         Notification[]
  payments              PaymentRecord[]          @relation("Payer")

  adminActionLogs AdminActionLog[] @relation("AdminActor")
  planRequests    PlanRequest[]
}

model Game {
  id         String   @id @default(uuid())
  name       String   @unique
  category   String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  tournaments   Tournament[]
  gameRequests  GameRequest[]
  clubRosters   ClubRoster[]
  clubInvites   ClubInvite[]
  clubTeams     ClubTeam[]
  templates     TournamentTemplate[]
  playerRatings PlayerGameRating[]
  challenges    Challenge[]
}

enum GameRequestStatus {
  pending
  approved
  rejected
}

model GameRequest {
  id             String            @id @default(uuid())
  organizerId    String
  organizer      OrganizerProfile  @relation(fields: [organizerId], references: [id])
  gameName       String
  status         GameRequestStatus @default(pending)
  reviewedById   String?
  createdAt      DateTime          @default(now())
  approvedGameId String?
  approvedGame   Game?             @relation(fields: [approvedGameId], references: [id])
}

// ------------------------------------------------------------
// ROLE PROFILES
// ------------------------------------------------------------

model PlayerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Required at the form/API level, nullable here so existing users
  // (created before these fields existed) aren't broken by a migration.
  firstName String?
  lastName  String?

  // All genuinely optional.
  mobileNumber  String?
  region        String?
  country       String?
  city          String?
  age           Int?
  gender        String?
  hobbies       String?
  favoriteGames String[] @default([])

  registrations   Registration[]
  teamMemberships TeamMember[]
  clubRoster      ClubRoster?
  clubInvites     ClubInvite[]
  tournamentVotes TournamentVote[]
  gameRatings     PlayerGameRating[]
  institution     PlayerInstitution?

  // Subscription plan (Phase 5). Code of a Plan row; an expired paid plan
  // is treated as free at read time (lib/plans.ts), no cron needed.
  planCode      String    @default("player_free")
  planExpiresAt DateTime?

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// INSTITUTION VERIFICATION (Phase 8.1, spec §8)
// Done once per player and reused by every institution-only tournament.
// The ID image lives in a PRIVATE storage bucket; only its path is stored.
// ------------------------------------------------------------

// Who may register for a tournament (spec §8). Institution-only tournaments
// need an approved PlayerInstitution (Phase 8.1) for every player on the entry.
enum AudienceScope {
  open
  institution
}

// Where a tournament is played (spec §8). Online uses the Room ID/Password
// flow; LAN uses a venue address and on-site check-in instead of room
// credentials. Hybrid (per-stage venue) comes in 8.4.
enum VenueType {
  online
  lan
  // Venue is decided per stage (online qualifiers -> LAN finals). Stages only
  // ever use online or lan.
  hybrid
}

enum CheckInStatus {
  pending
  checked_in
  no_show
}

enum InstitutionStatus {
  pending
  approved
  rejected
}

model PlayerInstitution {
  id       String        @id @default(uuid())
  playerId String        @unique
  player   PlayerProfile @relation(fields: [playerId], references: [id])

  institutionName String
  studentId       String? // the number printed on the ID, if the player wants to add it
  idImagePath     String // path inside the private "institution-ids" bucket

  status       InstitutionStatus @default(pending)
  adminNote    String? // shown to the player when rejected
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// An entry the organizer advanced into a stage (e.g. qualifiers -> finals).
// Carries that stage's own LAN check-in state.
model StageEntry {
  id             String       @id @default(uuid())
  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  checkInStatus   CheckInStatus @default(pending)
  checkedInAt     DateTime?
  checkInAttempts Int           @default(0)

  createdAt DateTime @default(now())

  @@unique([stageId, registrationId])
  @@index([registrationId])
}

// Which catalog currencies (lib/money.ts) organizers may pick for entry fees
// and prize pools. Admin-managed on /admin/currencies. Existing tournaments
// keep their currency even if it is switched off later.
model CurrencySetting {
  code      String   @id
  enabled   Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model OrganizerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orgName     String
  bio         String?
  socialLinks Json?

  // Subscription plan (Phase 5) — see PlanHolder in lib/plans.ts. Approval of
  // an organization application always starts on the free plan; a paid plan
  // the applicant picked is bought afterwards on /plans.
  planCode      String    @default("organizer_free")
  planExpiresAt DateTime?

  // Same free-text convention as PlayerProfile.country/region. Used to
  // resolve which CompetitiveTierSetting applies to this organizer's
  // tournaments (country match > region match > world default — spec §9,
  // "admin can set it by country, region, or world").
  country String?
  region  String?

  tournaments    Tournament[]
  gameRequests   GameRequest[]
  templates      TournamentTemplate[]
  members        OrganizationMember[]
  featuredSlides FeaturedSlide[]

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// ORGANIZATION REGISTRATION (admin-reviewed)
// ------------------------------------------------------------

enum OrgApplicationStatus {
  pending
  approved
  rejected
}

enum OrgMemberRole {
  manager
  staff
}

// An organization's request to join the platform. One row per account —
// a rejected applicant edits and resubmits THIS row (attemptCount goes up)
// rather than creating a new one. The OrganizerProfile is only created when
// an admin approves, so a pending/rejected applicant has no organizer access.
model OrganizationApplication {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orgName     String
  // Lowercased, letters+digits only ("Falcon Esports!" -> "falconesports").
  // Unique so two organizations can't hold near-identical names.
  orgNameKey  String @unique
  orgType     String
  description String

  registrationNumber String?
  website            String?
  country            String
  city               String
  address            String
  contactEmail       String
  contactPhone       String

  // The person running the organization's account.
  handlerName  String
  handlerRole  String
  handlerPhone String

  // Code of the Plan row the applicant picked (e.g. "organizer_pro"). Only
  // a preference: nothing is granted until they pay on /plans.
  plan   String               @default("organizer_free")
  status OrgApplicationStatus @default(pending)

  attemptCount   Int       @default(1) // how many times it has been submitted
  rejectionCount Int       @default(0)
  rejectionNote  String? // admin's overall message
  fieldFeedback  Json? // { fieldName: "what to fix" }
  nextResubmitAt DateTime? // set on rejection: 2h, then 24h, then 7d

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// People an approved organization adds to help run it. Added by email; if
// that email already has an account, userId is linked.
model OrganizationMember {
  id          String           @id @default(uuid())
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])

  email String
  name  String?
  role  OrgMemberRole @default(staff)

  createdAt DateTime @default(now())

  @@unique([organizerId, email])
}

// ------------------------------------------------------------
// ADMIN ANALYTICS
// ------------------------------------------------------------

// One row per browsing session (not per page view): who, from where, on what
// device. Written by the session beacon, read only by the admin panel. This
// holds personal data (IP address) — disclose it in the privacy policy and
// purge old rows with purgeOldVisits() in lib/services/analytics.ts.
model VisitSession {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  ip         String?
  country    String? // ISO code, e.g. "PK"
  region     String?
  city       String?
  deviceType String // desktop | mobile | tablet | unknown
  os         String?
  browser    String?
  path       String
  referrer   String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([country])
}

enum PaymentKind {
  club_upgrade
  org_plan
  player_plan
  other
}

// A manual ledger of money the PLATFORM received (paid club plans, organization
// plans). There is no payment gateway yet, so an admin records each payment —
// club upgrades are recorded when the admin approves the payment proof.
model PaymentRecord {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation("Payer", fields: [userId], references: [id])
  kind   PaymentKind

  amount    Decimal @db.Decimal(14, 2)
  currency  String
  method    String // "JazzCash", "Bank transfer", …
  reference String?
  note      String?

  recordedById String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ------------------------------------------------------------
// CLUB NAME PROTECTION + ACCOUNT BANS
// ------------------------------------------------------------

// A ban blocks the whole account EXCEPT logging in: a banned user signs in
// and is shown the reason plus how to contact support. endsAt = null means
// permanent. History is kept; "active" = not lifted and not expired.
model AccountBan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("BannedUser", fields: [userId], references: [id])

  reason      String
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdById String
  liftedAt    DateTime?
  liftedById  String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum ClubNameClaimStatus {
  pending
  upheld
  dismissed
}

// Someone says "that club is using MY name". If an admin upholds it, the
// squatting club is disbanded, its owner is banned for the duration the
// admin picks, and the name is held for the claimant until they use it.
model ClubNameClaim {
  id         String @id @default(uuid())
  claimantId String
  claimant   User   @relation("ClaimantUser", fields: [claimantId], references: [id])

  nameKey  String // the contested name, normalized
  clubName String // as typed in the claim
  clubId   String? // the club holding the name when the claim was filed

  explanation String
  evidenceUrl String?

  status       ClubNameClaimStatus @default(pending)
  adminNote    String?
  banDays      Int? // what the admin chose on upholding; null = permanent
  reviewedById String?
  reviewedAt   DateTime?

  // Set when the claimant actually creates the club/organization with the
  // name. Until then the name is reserved for them.
  fulfilledAt DateTime?

  createdAt DateTime @default(now())

  @@index([nameKey])
  @@index([claimantId])
}

// ------------------------------------------------------------
// TOURNAMENT TEMPLATES (Phase 3)
// ------------------------------------------------------------

// Saves a tournament's whole reusable config — everything EXCEPT
// instance-specific fields (date, room credentials) — spec §5. "Start from
// Template" pre-fills the new-tournament form from this; the organizer edits
// whatever changed before creating. Rules and stages copied INTO a new
// tournament are that tournament's own rows from then on — editing or
// deleting the template later never touches a tournament already created
// from it, same snapshot rule as SuggestedRule (spec §5).
model TournamentTemplate {
  id          String           @id @default(uuid())
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])
  name        String

  gameId         String
  game           Game             @relation(fields: [gameId], references: [id])
  type           TournamentType
  mode           TournamentMode
  maxTeamSize    Int?
  maxTeams       Int
  playersPerRoom Int?
  format         TournamentFormat

  entryType           EntryType
  entryFeeAmount      Decimal?  @db.Decimal(14, 2)
  entryFeeCurrency    String?
  paymentInstructions String?
  prizePoolAmount     Decimal?  @db.Decimal(14, 2)
  prizePoolCurrency   String?

  audienceScope                AudienceScope @default(open)
  requireFreshInstitutionProof Boolean       @default(false)
  venueType                    VenueType     @default(online)

  // Same shape as Tournament.customFields — an array of {key, label, type,
  // required}. Copied as-is into a new tournament.
  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules  TemplateRule[]
  stages TemplateStage[]
}

// A rule as saved in a template — same shape as TournamentRule (spec §5's
// "rule set"), minus stage scoping (a template's stages are just names, not
// real Stage rows yet, so there is nothing to scope to until the tournament
// exists).
model TemplateRule {
  id         String             @id @default(uuid())
  templateId String
  template   TournamentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title         String?
  description   String
  action        RuleAction @default(warning)
  penaltyPoints Int?
  position      Int        @default(0)

  // Provenance only, same as TournamentRule.suggestedRuleId.
  suggestedRuleId String?
  suggestedRule   SuggestedRule? @relation(fields: [suggestedRuleId], references: [id], onDelete: SetNull)
}

// A stage NAME and order only — a real Stage also has a date and room
// credentials, which are instance-specific and never saved in a template.
model TemplateStage {
  id         String             @id @default(uuid())
  templateId String
  template   TournamentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int
}

// ------------------------------------------------------------
// CLUB MODULE (Phase 2)
// ------------------------------------------------------------

// Mirrors the organizer approval pattern: club signs up, pays the
// registration fee (screenshot proof), admin approves.
enum ClubStatus {
  pending
  approved
  rejected
  // Taken down after an upheld name claim. The row is kept for history but
  // the club can no longer act (every club feature requires "approved").
  disbanded
}

// Clubs are created instantly and free. A PAID plan needs a registration-fee
// payment proof that an admin verifies; this tracks that upgrade request.
enum ClubUpgradeStatus {
  none
  pending
  rejected
}

model ClubProfile {
  id     String @id @default(uuid())
  userId String @unique // club owner account
  user   User   @relation(fields: [userId], references: [id])

  clubName String
  logoUrl  String?

  status      ClubStatus @default(approved)
  feeProofUrl String? // screenshot of the PAID-plan fee payment (upgrade only)

  // Normalized name (see lib/org-name.ts) — unique, so "Falcon" and
  // "falcon!" can't both exist. Cleared when a club is disbanded so the
  // rightful owner can take the name. Null on clubs created before this
  // existed; lib/services/club-names.ts checks those by scanning.
  nameKey        String?         @unique
  featuredSlides FeaturedSlide[]

  upgradeStatus ClubUpgradeStatus @default(none)
  disbandedAt   DateTime?
  disbandReason String?

  // Subscription plan (Phase 5): code of a Plan row. Limits come from that
  // row via lib/club-limits.ts; an expired paid plan counts as free.
  subscriptionPlanCode String    @default("club_free")
  planExpiresAt        DateTime?

  teams       ClubTeam[]
  roster      ClubRoster[]
  invites     ClubInvite[]
  teamEntries TeamEntry[]

  createdAt DateTime @default(now())
}

// A named team a club fields in a team game (e.g. "Alpha" and "Bravo" in
// PUBG Mobile). Solo games (Tekken, Chess...) have no ClubTeam — those
// roster members simply have teamId = null.
// How many teams a club may have per game is a subscription limit
// (Phase 5), enforced in the service layer, not here.
model ClubTeam {
  id     String      @id @default(uuid())
  clubId String
  club   ClubProfile @relation(fields: [clubId], references: [id])
  gameId String
  game   Game        @relation(fields: [gameId], references: [id])
  name   String

  // Plain text — set by the club owner, paid clubs only (Phase 5 gate).
  // No uniqueness: the same coach name can appear on any club/team.
  coachName String?

  // Per-game team rating (spec §9) — a club team persists across
  // tournaments (unlike an ad-hoc non-club squad, which has no identity
  // once its one tournament ends), so it's the only "team" that can
  // meaningfully carry a rating rather than each member's individual one.
  rating Int @default(1000)

  members               ClubRoster[]
  invites               ClubInvite[]
  entries               TeamEntry[]
  challengeApplications ChallengeApplication[]

  createdAt DateTime @default(now())

  @@unique([clubId, gameId, name])
  @@index([clubId, gameId])
}

// Coaches are NOT roster members — they're just a plain name on the team
// (ClubTeam.coachName), no account or invite involved.
enum ClubRosterRole {
  player
  substitute
}

// Permanent roster. A person is on AT MOST ONE club's roster, in ONE
// game, in ONE role (and on one team, for team games) — enforced by the
// unique constraint on playerId. Rows are only created by accepting a
// ClubInvite (never inserted directly), and accepting replaces any
// existing row for that person in one transaction.
// Invariant kept in the service layer: if teamId is set, gameId must
// equal the team's gameId and clubId the team's clubId.
// Editable anytime — the per-tournament roster lock lives on the
// tournament's TeamEntry/TeamMember rows, not here.
model ClubRoster {
  id        String         @id @default(uuid())
  clubId    String
  club      ClubProfile    @relation(fields: [clubId], references: [id])
  playerId  String         @unique
  player    PlayerProfile  @relation(fields: [playerId], references: [id])
  gameId    String
  game      Game           @relation(fields: [gameId], references: [id])
  teamId    String? // null for solo games
  team      ClubTeam?      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  role      ClubRosterRole @default(player)
  // Only meaningful when teamId is set. The captain, along with the club
  // owner, may submit/edit this team's tournament entries. At most one
  // captain per team — enforced in the service layer (setTeamCaptain).
  isCaptain Boolean        @default(false)
  joinedAt  DateTime       @default(now())

  @@index([clubId, gameId])
  @@index([teamId])
}

enum ClubInviteStatus {
  pending
  accepted
  declined
  cancelled // club withdrew it before the player responded
}

// A club invites a person to its roster for a specific game (and team +
// role, for team games). Kept as history (never deleted).
// "One pending invite per (club, player)" is enforced in the service layer.
model ClubInvite {
  id       String           @id @default(uuid())
  clubId   String
  club     ClubProfile      @relation(fields: [clubId], references: [id])
  playerId String
  player   PlayerProfile    @relation(fields: [playerId], references: [id])
  gameId   String
  game     Game             @relation(fields: [gameId], references: [id])
  teamId   String?
  team     ClubTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  role     ClubRosterRole   @default(player)
  status   ClubInviteStatus @default(pending)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([playerId, status])
  @@index([clubId, status])
}

// ------------------------------------------------------------
// TOURNAMENT CORE
// ------------------------------------------------------------

enum TournamentType {
  tournament
  league
  scrim
}

enum TournamentMode {
  solo
  duo
  squad
}

enum TournamentFormat {
  single_elimination
  double_elimination
  round_robin
  points_table
  league_format
}

enum EntryType {
  free
  paid
}

enum TournamentStatus {
  draft
  published
  registration_open
  registration_closed
  in_progress
  completed
  cancelled
}

// Enforced by CompetitiveTierSetting (the admin-configurable ladder),
// PlayerGameRating/ClubTeam.rating (the rating engine), and the
// resolveTierSetting/checkTierEntryGate functions in
// lib/services/competitive-tiers.ts — see Phase 6.
enum CompetitiveTier {
  none
  D
  C
  B
  A
  S
  National
}

// Admin-configurable tier ladder (spec §9) — never hardcoded. One row per
// (tier, scope) combination; "world" is the mandatory fallback so every
// tier always resolves to *something* even where no country/region
// override has been set. Resolution order when gating a tournament or a
// registration: the organizer's country, then their region, then world.
model CompetitiveTierSetting {
  id String @id @default(uuid())

  tier       CompetitiveTier // never "none" — that's "not competitive", not a tier
  scope      TierSettingScope
  // Country/region name, matched against OrganizerProfile.country/region
  // (case-insensitive, exact match). Null when scope is "world".
  scopeValue String?

  minPrizePoolUsd Decimal @db.Decimal(14, 2)
  // Rating gate for D/C/B/A/S — null for D and C (spec: "None / light
  // floor"). Not used for National, which gates on minWins instead.
  minRating       Int?
  // National-only: "5+ S-tier wins" — a completed-tournament win count,
  // not a rating threshold (see getNationalEligibility).
  minWins         Int?

  publishPath TierPublishPath @default(instant)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tier, scope, scopeValue])
}

enum TierSettingScope {
  world
  region
  country
}

enum TierPublishPath {
  instant
  // B/A per spec are "Instant (auto-checked)" — same publishPath as D/C
  // from the settings' point of view (no human review), the "auto-checked"
  // part is just the rating-gate check the registration flow already does.
  admin_review
  always_admin
}

// Per-game player rating (spec §9: "per-game — never blended into one
// number"). Only moves from Tournament results, never Leagues/Scrims.
// Baseline 1000 is an arbitrary starting point, easy to change later —
// what matters per spec is relative movement, not the absolute number.
model PlayerGameRating {
  id       String        @id @default(uuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id])
  gameId   String
  game     Game          @relation(fields: [gameId], references: [id])

  rating Int @default(1000)

  updatedAt DateTime @updatedAt

  @@unique([playerId, gameId])
}

model Tournament {
  id          String           @id @default(uuid())
  slug        String           @unique
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])
  gameId      String
  game        Game             @relation(fields: [gameId], references: [id])

  name        String
  description String?
  bannerUrl   String?

  type           TournamentType
  mode           TournamentMode
  maxTeamSize    Int?
  maxTeams       Int
  playersPerRoom Int?
  format         TournamentFormat

  entryType           EntryType
  entryFeeAmount      Decimal?  @db.Decimal(14, 2)
  entryFeeCurrency    String?
  // Free text: "JazzCash 0300-1234567 (Ali)", "Bank transfer to ...", etc.
  // Shown to the player on the join page, above the payment-proof upload,
  // so they know where to actually send money before being asked to prove
  // they sent it. Only meaningful when entryType is "paid".
  paymentInstructions String?

  prizePoolAmount   Decimal? @db.Decimal(14, 2)
  prizePoolCurrency String?
  // Organizer-confirmed that prize money actually went out (spec §10).
  // Only payout-confirmed prize pools count toward the organizer's public
  // "Total Prize Pool Distributed".
  payoutConfirmed   Boolean  @default(false)

  competitiveTier CompetitiveTier @default(none)

  // ISO-3166 alpha-2 (see lib/geo-data.ts). Null = worldwide / open to anyone.
  // The broader region (South Asia, ...) is derived from this, never stored.
  country String?

  venueType       VenueType @default(online)
  venueName       String?
  venueAddress    String?
  venueCity       String?
  // LAN only. Players can self check-in inside this window by typing the code
  // the organizer shows at the venue desk; the organizer can always check
  // people in or mark no-shows by hand. checkInCode is organizer-only: it is
  // stripped from every public response.
  checkInOpensAt  DateTime?
  checkInClosesAt DateTime?
  checkInCode     String?

  audienceScope                AudienceScope @default(open)
  // Institution-only tournaments only: also ask the registering player for a
  // fresh ID photo with THIS registration, on top of their verified profile.
  requireFreshInstitutionProof Boolean       @default(false)

  customFields Json?

  status             TournamentStatus @default(draft)
  // Set when an organizer tries to publish an S/National-tier tournament
  // (spec §9: "Admin review required" / "Always Admin-approved"). Tournament
  // stays "draft" — status itself is untouched — while this is true; an
  // admin approving flips status straight to "published" and clears this,
  // rejecting just clears it so the organizer can edit and resubmit. Kept
  // as a separate flag rather than a new status value so nothing else that
  // reads TournamentStatus (registration gating, capacity checks, etc.)
  // needs to learn about a new in-between state.
  submittedForReview Boolean          @default(false)
  startAt            DateTime?

  // Basic shareable-link tracking (spec §3) — incremented on a real page
  // view and on a successful registration.
  clickCount        Int @default(0)
  registrationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages        Stage[]
  rules         TournamentRule[]
  registrations Registration[]
  flags         TournamentFlag[]
  teamEntries   TeamEntry[]
  votes         TournamentVote[]
  featured      FeaturedTournament?

  @@index([audienceScope])
  @@index([venueType])
  @@index([country])
}

// One like/dislike per player per tournament, and only if they actually
// joined (spec §10).
model TournamentVote {
  id           String        @id @default(uuid())
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId], references: [id])
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id])
  value        VoteValue

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, playerId])
}

enum VoteValue {
  like
  dislike
}

model Stage {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  name  String
  order Int

  startAt      DateTime?
  roomId       String?
  roomPassword String?
  roomRevealAt DateTime?

  status String @default("upcoming")

  // Venue per stage (Phase 8.4). Only meaningful when the tournament is
  // hybrid; otherwise stages follow the tournament's own venue.
  venueType       VenueType @default(online)
  venueName       String?
  venueAddress    String?
  venueCity       String?
  checkInOpensAt  DateTime?
  checkInClosesAt DateTime?
  checkInCode     String? // organizer-only, LAN stages
  // true = only entries the organizer advanced into this stage may use its
  // room / check in. LAN stages of a hybrid tournament are always restricted.
  restricted      Boolean   @default(false)

  entries StageEntry[]

  rules TournamentRule[]
}

// Phase 1: simple free-text rules. Structured type/severity + rule sets
// + templates are Phase 3 — see schema.full.prisma.
// What happens when a rule is broken.
enum RuleAction {
  warning
  point_deduction
  disqualification
}

// The catalog behind the "+" button when an organizer adds rules. This is
// DATA, not code: admins add/edit/hide suggestions from the admin panel and
// nothing in the app depends on any particular one existing. Adding one to a
// tournament COPIES it into a TournamentRule, so editing or deleting a
// suggestion later never changes a tournament that already has it (spec §5).
model SuggestedRule {
  id            String     @id @default(uuid())
  title         String
  description   String
  action        RuleAction @default(warning)
  penaltyPoints Int? // only for point_deduction
  // Matches Game.category ("mobile", "pc", ...). null = suggested for every game.
  gameCategory  String?
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  tournamentRules TournamentRule[]
  templateRules   TemplateRule[]
}

// A rule as it applies to ONE tournament — its own snapshot, whether it
// started as a suggestion or was written by the organizer.
model TournamentRule {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  description  String

  // Short name ("No emulators"). Optional so rules that predate this (plain
  // text) keep working — those show just their description.
  title         String?
  action        RuleAction @default(warning)
  penaltyPoints Int? // required when action is point_deduction, otherwise null
  position      Int        @default(0) // display order

  // Optional: the rule only applies to one stage (e.g. Finals).
  appliesToStageId String?
  appliesToStage   Stage?  @relation(fields: [appliesToStageId], references: [id])

  // Where it was copied from, if it was a suggestion. Provenance only.
  suggestedRuleId String?
  suggestedRule   SuggestedRule? @relation(fields: [suggestedRuleId], references: [id], onDelete: SetNull)

  disqualifications Registration[] @relation("DisqualifiedRule")
}

// ------------------------------------------------------------
// REGISTRATION & TEAMS
// ------------------------------------------------------------

enum RegistrationStatus {
  pending
  approved
  rejected
  disqualified
}

enum PaymentStatus {
  unpaid
  paid
  waived
}

enum AddedBy {
  self
  organizer
}

model TeamEntry {
  id           String       @id @default(uuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  name         String
  clubId       String?
  club         ClubProfile? @relation(fields: [clubId], references: [id])
  // Which permanent ClubTeam this entry represents, if any. Lets the club
  // find/edit "our entry for team X in tournament Y", and distinguishes a
  // club entry from an ad-hoc team a non-club player formed at registration.
  clubTeamId   String?
  clubTeam     ClubTeam?    @relation(fields: [clubTeamId], references: [id])

  members      TeamMember[]
  registration Registration?
}

model TeamMember {
  id          String        @id @default(uuid())
  teamEntryId String
  teamEntry   TeamEntry     @relation(fields: [teamEntryId], references: [id])
  playerId    String
  player      PlayerProfile @relation(fields: [playerId], references: [id])
}

model Registration {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  playerId    String?
  player      PlayerProfile? @relation(fields: [playerId], references: [id])
  teamEntryId String?        @unique
  teamEntry   TeamEntry?     @relation(fields: [teamEntryId], references: [id])

  status               RegistrationStatus @default(pending)
  paymentStatus        PaymentStatus      @default(unpaid)
  paymentProofUrl      String?
  // Private-bucket path of the per-tournament ID photo (see
  // Tournament.requireFreshInstitutionProof). Never exposed as a public URL.
  institutionProofPath String?

  // LAN check-in (a team entry checks in as one unit).
  checkInStatus   CheckInStatus @default(pending)
  checkedInAt     DateTime?
  checkInAttempts Int           @default(0) // wrong-code tries; locks self check-in at 5
  stageEntries    StageEntry[]
  addedBy         AddedBy       @default(self)

  disqualifiedRuleId String?
  disqualifiedRule   TournamentRule? @relation("DisqualifiedRule", fields: [disqualifiedRuleId], references: [id])
  disqualifiedReason String?

  customFieldResponses Json?

  // Results/standings — set by the organizer once a tournament has matches
  // to report. Nullable: most registrations never get a placement (only
  // those who actually finished/placed do), and points is separate from
  // placement since some formats (points-table, league) rank by points
  // rather than a single final placement.
  placement Int?
  points    Int?

  registeredAt DateTime  @default(now())
  approvedAt   DateTime?
}

model SiteSettings {
  id                      String   @id @default("singleton")
  logoUrl                 String?
  // Shown on the club registration form: amount + where to send the fee.
  clubPaymentInstructions String?
  // Shown on the plan-upgrade form: where to send the plan payment.
  planPaymentInstructions String?
  // Ads stay off until an ad network is wired into components/ui/AdSlot.
  adsEnabled              Boolean  @default(false)
  // A challenge whose cash prize (in USD) is above this waits for admin
  // approval before it goes live. Plan caps (Plan.limits) apply first.
  challengeReviewUsd      Decimal  @default(10000) @db.Decimal(14, 2)
  updatedAt               DateTime @updatedAt
}

// ------------------------------------------------------------
// CHALLENGES
// ------------------------------------------------------------

enum ChallengePosterType {
  organizer
  club
  player
}

// Who may take the challenge on.
enum ChallengeEntrantType {
  player
  team
  either
}

enum ChallengePrizeType {
  cash // money, paid by the poster directly (the platform never holds funds)
  in_game // in-game currency/items, e.g. "600 UC", delivered to the winner
  reward // anything else, e.g. free entry to the poster's scrim or league
}

enum ChallengeStatus {
  pending_review // over the admin-review prize threshold; not public yet
  open // accepting applications
  in_progress // challenger(s) chosen, playing
  completed
  expired // nobody was chosen before the deadline
  cancelled
  rejected // admin declined it
}

// A poster (organization, club or player on a plan that allows it) offers a
// prize to whoever beats them / completes a task. Posting is capped by the
// poster's plan (count per month, prize size) — see lib/services/challenges.ts.
model Challenge {
  id           String              @id @default(uuid())
  posterUserId String
  poster       User                @relation("ChallengePoster", fields: [posterUserId], references: [id])
  posterType   ChallengePosterType
  // Snapshot of the organization / club / player name at posting time.
  posterName   String

  title       String
  description String // the rules: what has to be done to win
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id])

  entrantType ChallengeEntrantType @default(either)
  // Applicants need at least this rating in the game (Phase 6 ratings).
  minRating   Int?

  // How many challengers the poster will pick, and how many applications are
  // accepted before the challenge stops taking more (anti-flooding).
  slots               Int
  maxApplicants       Int
  applicationsCloseAt DateTime
  // How long the chosen challenger(s) have to complete it, set by the poster.
  completeWithinDays  Int

  prizeType        ChallengePrizeType
  prizeDescription String // e.g. "600 UC", "Free entry to our weekend scrim"
  cashAmount       Decimal?           @db.Decimal(14, 2)
  cashCurrency     String?
  // USD value used for plan caps and the review threshold: converted from
  // the cash amount, or the poster's estimate for in-game prizes.
  prizeUsd         Decimal?           @db.Decimal(14, 2)
  // How the poster will pay/deliver (e.g. "JazzCash or bank transfer, PKR").
  payoutMethod     String

  status       ChallengeStatus        @default(open)
  // Set when the poster confirms their pick: the chosen challenger(s) must
  // finish by completeBy (selectedAt + completeWithinDays).
  selectedAt   DateTime?
  completeBy   DateTime?
  applications ChallengeApplication[]
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([posterUserId, posterType, createdAt])
  @@index([gameId])
}

model AuthCarouselSlide {
  id        String   @id @default(uuid())
  mediaUrl  String
  mediaType String // "image" | "video"
  title     String?
  text      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// ADMIN / AUDIT — minimal Phase 1 panel
// ------------------------------------------------------------

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminActor", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  notes      String?
  createdAt  DateTime @default(now())
}

// Lightweight moderation stub — any authenticated user can flag a
// tournament with a reason; admin reviews the queue. Full dispute system
// with resolution workflow is Phase 7, this is just a signal + queue.
model TournamentFlag {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  reporterId   String
  reason       String
  resolved     Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

// ------------------------------------------------------------
// SUBSCRIPTION PLANS (Phase 5)
// ------------------------------------------------------------

enum PlanAudience {
  organizer
  club
  player
}

// Admin-editable plan definitions (spec §7). `limits` is a JSON object whose
// shape depends on `audience` — see lib/plans.ts for the keys and defaults.
// Limits are convenience/cosmetic only; free plans never gate anything
// competitive (joining, rating, tier eligibility).
model Plan {
  code          String       @id // e.g. "organizer_free", "club_pro"
  audience      PlanAudience
  name          String
  isPaid        Boolean      @default(false)
  priceAmount   Decimal?     @db.Decimal(14, 2)
  priceCurrency String?
  durationDays  Int          @default(30)
  limits        Json         @default("{}")
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)

  requests PlanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, sortOrder])
}

enum PlanRequestStatus {
  pending
  approved
  rejected
}

// An account asks to move to a paid plan and uploads payment proof (same
// screenshot-proof flow as club registration). An admin approves or rejects.
model PlanRequest {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  audience   PlanAudience
  planCode   String
  plan       Plan              @relation(fields: [planCode], references: [code])
  proofUrl   String
  status     PlanRequestStatus @default(pending)
  adminNote  String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId, audience])
}

// ------------------------------------------------------------
// FEATURED CONTENT (admin-curated)
// ------------------------------------------------------------

// Slides in the big carousel at the top of dashboards. A slide may belong to
// an organization or a club: it is only shown while that account's plan has
// the `dashboardCarousel` perk (so the edge ends when the plan lapses).
// A slide with neither is a platform announcement and always shows.
model FeaturedSlide {
  id          String            @id @default(uuid())
  imageUrl    String
  title       String
  text        String?
  linkUrl     String?
  organizerId String?
  organizer   OrganizerProfile? @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  clubId      String?
  club        ClubProfile?      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  isActive    Boolean           @default(true)
  position    Int               @default(0)
  createdAt   DateTime          @default(now())

  @@index([isActive, position])
}

// The admin's hand-picked "upcoming tournaments" list.
model FeaturedTournament {
  id           String     @id @default(uuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
}

enum ChallengeApplicationStatus {
  applied
  selected
  not_selected // another challenger was picked, or the challenge was cancelled
  withdrawn
}

enum ChallengeStage {
  playing // picked; must submit proof before the challenge deadline
  proof_review // proof sent; poster has 48h to confirm or dispute (silence = confirmed)
  proof_disputed // poster disputed the proof; an admin decides
  awaiting_payout_details // win confirmed; challenger adds where to send the prize
  awaiting_payment // poster has 72h to pay/deliver and upload the receipt
  payment_sent // poster says paid; challenger confirms (silence for 5 days = received)
  payment_disputed // "not received" / "never paid"; poster has 24h to show proof
  completed
  failed // no proof in time, proof rejected, or no payout details
}

enum ChallengeDisputeKind {
  proof // poster disputes the challenger's proof of winning
  payment // challenger says the prize was not paid / not received
}

enum ChallengeDisputeStatus {
  awaiting_response // the other side has 24h to answer
  awaiting_admin // answered, or the 24h passed: an admin decides
  resolved
}

enum ChallengeDisputeOutcome {
  for_challenger
  for_poster
}

enum ChallengeEntrantKind {
  player
  team
}

// One application per account per challenge. A club owner applies with one of
// the club's teams; a player applies as themselves. Rating is a snapshot so
// the poster sees what the applicant had when they applied.
model ChallengeApplication {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  applicantUserId String
  applicant       User   @relation("ChallengeApplicant", fields: [applicantUserId], references: [id])

  kind        ChallengeEntrantKind
  clubTeamId  String?
  clubTeam    ClubTeam?            @relation(fields: [clubTeamId], references: [id])
  entrantName String // player display name, or "Team name (Club name)"
  rating      Int
  message     String?

  status    ChallengeApplicationStatus @default(applied)
  decidedAt DateTime?

  // ---- Once picked (status = selected): proof -> payment -> done. `stage`
  // says where the entry is and `stageDeadline` when the current step lapses.
  stage              ChallengeStage     @default(playing)
  stageDeadline      DateTime?
  // The win: a match/game ID and screenshots (result + match history).
  matchId            String?
  proofUrls          String[]
  proofNote          String?
  proofSubmittedAt   DateTime?
  // Where to send the prize. Shown only to the poster, and erased once the
  // entry completes or fails.
  payoutDetails      String?
  // The poster's receipt (cash) or delivery screenshot (in-game / reward).
  paymentReceiptUrls String[]
  paymentNote        String?
  paymentSentAt      DateTime?
  // An admin ruled the poster owes the prize: keeps their account frozen
  // until it's paid.
  paymentOwed        Boolean            @default(false)
  completedAt        DateTime?
  failedReason       String?
  disputes           ChallengeDispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, applicantUserId])
  @@index([challengeId, status])
  @@index([applicantUserId])
}

// In-app notifications (the project sends no email): applications, picks,
// and — in the next parts — proof, payment and dispute deadlines.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type  String
  title String
  body  String?
  href  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// A disagreement over one entry: either the poster doubts the proof, or the
// challenger says the prize never arrived. The side being accused gets 24h to
// answer with evidence; then an admin decides. For payment disputes the poster
// is frozen (can't post or take applications) until it is settled.
model ChallengeDispute {
  id            String               @id @default(uuid())
  applicationId String
  application   ChallengeApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  challengeId   String

  kind               ChallengeDisputeKind
  openedById         String
  reason             String
  openerEvidenceUrls String[]

  responderNote         String?
  responderEvidenceUrls String[]
  respondedAt           DateTime?
  responseDueAt         DateTime

  status         ChallengeDisputeStatus   @default(awaiting_response)
  // The accused side didn't answer in time.
  missedDeadline Boolean                  @default(false)
  outcome        ChallengeDisputeOutcome?
  adminNote      String?
  resolvedById   String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([applicationId])
  @@index([challengeId])
}
