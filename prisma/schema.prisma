// ============================================================
// Esports Tournament Platform — Database Schema (PHASE 1 ONLY)
// Postgres + Prisma ORM
//
// This is the trimmed, launch-critical subset. The full 9-phase
// schema (Club, Merch, Ratings, Donations, etc.) is preserved in
// schema.full.prisma — copy sections back in as each phase is built,
// rather than migrating everything up front.
//
// Design principles:
// - Money fields ALWAYS store {amount, currency} together
// - JSONB (Json fields) used only for genuinely variable-shape data
//   (organizer custom registration fields)
// - Rules are simple free-text at Phase 1 (structured rules + severity
//   come in Phase 3 — see schema.full.prisma for that version)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// IDENTITY
// ------------------------------------------------------------

enum KycStatus {
  none
  pending
  approved
  rejected
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  kycStatus    KycStatus @default(none) // doubles as the organizer-approval gate in Phase 1
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  playerProfile    PlayerProfile?
  organizerProfile OrganizerProfile?

  adminActionLogs AdminActionLog[] @relation("AdminActor")
}

model Game {
  id         String   @id @default(uuid())
  name       String   @unique
  category   String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  tournaments  Tournament[]
  gameRequests GameRequest[]
}

enum GameRequestStatus {
  pending
  approved
  rejected
}

model GameRequest {
  id             String            @id @default(uuid())
  organizerId    String
  organizer      OrganizerProfile  @relation(fields: [organizerId], references: [id])
  gameName       String
  status         GameRequestStatus @default(pending)
  reviewedById   String?
  createdAt      DateTime          @default(now())
  approvedGameId String?
  approvedGame   Game?             @relation(fields: [approvedGameId], references: [id])
}

// ------------------------------------------------------------
// ROLE PROFILES
// ------------------------------------------------------------

model PlayerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  registrations   Registration[]
  teamMemberships TeamMember[]

  createdAt DateTime @default(now())
}

model OrganizerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orgName     String
  bio         String?
  socialLinks Json?

  tournaments  Tournament[]
  gameRequests GameRequest[]

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// TOURNAMENT CORE
// ------------------------------------------------------------

enum TournamentType {
  tournament
  league
  scrim
}

enum TournamentMode {
  solo
  duo
  squad
}

enum TournamentFormat {
  single_elimination
  double_elimination
  round_robin
  points_table
  league_format
}

enum EntryType {
  free
  paid
}

enum TournamentStatus {
  draft
  published
  registration_open
  registration_closed
  in_progress
  completed
  cancelled
}

// Kept as an enum for forward-compatibility with Phase 6, but no
// enforcement/config table exists yet in this trimmed schema.
enum CompetitiveTier {
  none
  D
  C
  B
  A
  S
  National
}

model Tournament {
  id          String           @id @default(uuid())
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])
  gameId      String
  game        Game             @relation(fields: [gameId], references: [id])

  name        String
  description String?
  bannerUrl   String?

  type           TournamentType
  mode           TournamentMode
  maxTeamSize    Int?
  maxTeams       Int
  playersPerRoom Int?
  format         TournamentFormat

  entryType        EntryType
  entryFeeAmount   Decimal? @db.Decimal(14, 2)
  entryFeeCurrency String?

  prizePoolAmount   Decimal? @db.Decimal(14, 2)
  prizePoolCurrency String?

  competitiveTier CompetitiveTier @default(none)

  customFields Json?

  status  TournamentStatus @default(draft)
  startAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages        Stage[]
  rules         TournamentRule[]
  registrations Registration[]
  teamEntries   TeamEntry[]
}

model Stage {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  name  String
  order Int

  startAt      DateTime?
  roomId       String?
  roomPassword String?
  roomRevealAt DateTime?

  status String @default("upcoming")
}

// Phase 1: simple free-text rules. Structured type/severity + rule sets
// + templates are Phase 3 — see schema.full.prisma.
model TournamentRule {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  description  String

  disqualifications Registration[] @relation("DisqualifiedRule")
}

// ------------------------------------------------------------
// REGISTRATION & TEAMS
// ------------------------------------------------------------

enum RegistrationStatus {
  pending
  approved
  rejected
  disqualified
}

enum PaymentStatus {
  unpaid
  paid
  waived
}

enum AddedBy {
  self
  organizer
}

model TeamEntry {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  name         String
  // clubId intentionally omitted — Club module is Phase 2,
  // see schema.full.prisma for the club-linked version.

  members      TeamMember[]
  registration Registration?
}

model TeamMember {
  id          String        @id @default(uuid())
  teamEntryId String
  teamEntry   TeamEntry     @relation(fields: [teamEntryId], references: [id])
  playerId    String
  player      PlayerProfile @relation(fields: [playerId], references: [id])
}

model Registration {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  playerId    String?
  player      PlayerProfile? @relation(fields: [playerId], references: [id])
  teamEntryId String?        @unique
  teamEntry   TeamEntry?     @relation(fields: [teamEntryId], references: [id])

  status          RegistrationStatus @default(pending)
  paymentStatus   PaymentStatus      @default(unpaid)
  paymentProofUrl String?
  addedBy         AddedBy            @default(self)

  disqualifiedRuleId String?
  disqualifiedRule   TournamentRule? @relation("DisqualifiedRule", fields: [disqualifiedRuleId], references: [id])

  customFieldResponses Json?

  registeredAt DateTime  @default(now())
  approvedAt   DateTime?
}

// ------------------------------------------------------------
// ADMIN / AUDIT — minimal Phase 1 panel
// ------------------------------------------------------------

model AdminActionLog {
  id         String @id @default(uuid())
  adminId    String
  admin      User   @relation("AdminActor", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  notes      String?
  createdAt  DateTime @default(now())
}
