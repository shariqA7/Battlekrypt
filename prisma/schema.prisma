// ============================================================
// Esports Tournament Platform — Database Schema (PHASE 1 + PHASE 2 CLUB CORE)
// Postgres + Prisma ORM
//
// This is the trimmed, launch-critical subset. The full 9-phase
// schema (Club, Merch, Ratings, Donations, etc.) is preserved in
// schema.full.prisma — copy sections back in as each phase is built,
// rather than migrating everything up front.
//
// Design principles:
// - Money fields ALWAYS store {amount, currency} together
// - JSONB (Json fields) used only for genuinely variable-shape data
//   (organizer custom registration fields)
// - Rules are simple free-text at Phase 1 (structured rules + severity
//   come in Phase 3 — see schema.full.prisma for that version)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// IDENTITY
// ------------------------------------------------------------

enum KycStatus {
  none
  pending
  approved
  rejected
}

model User {
  id          String    @id // matches Supabase auth.users.id — not auto-generated here
  email       String?   @unique
  phone       String?   @unique
  displayName String
  avatarUrl   String?
  // ORGANIZER APPROVAL (an admin accepted the organization application). Despite
  // the name this is NOT an identity check: that is IdentityVerification below,
  // and only that earns the Verified badge and lifts the starter limits.
  kycStatus   KycStatus @default(none)
  isAdmin     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playerProfile         PlayerProfile?
  organizerProfile      OrganizerProfile?
  clubProfile           ClubProfile?
  orgApplication        OrganizationApplication?
  orgMemberships        OrganizationMember[]
  bans                  AccountBan[]             @relation("BannedUser")
  nameClaims            ClubNameClaim[]          @relation("ClaimantUser")
  visits                VisitSession[]
  challenges            Challenge[]              @relation("ChallengePoster")
  challengeReports      ChallengeReport[]
  challengeApplications ChallengeApplication[]   @relation("ChallengeApplicant")
  notifications         Notification[]
  payments              PaymentRecord[]          @relation("Payer")

  adminActionLogs AdminActionLog[] @relation("AdminActor")
  planRequests    PlanRequest[]
}

model Game {
  id         String   @id @default(uuid())
  name       String   @unique
  category   String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Display group and roster rules (see lib/game-catalog.ts). All optional: a game with no
  // rules (for example one added through "Request a game") has no limits beyond a club's plan.
  genre          String? // FPS / Shooters, MOBA, Battle Royale, ...
  format         String? // multiplayer | one_on_one | free_for_all | both
  teamSizeMin    Int? // players who actually play ...
  teamSizeMax    Int? // ... as a range only where the format varies
  maxSubstitutes Int?
  allowsCoach    Boolean @default(true)
  rosterNotes    String?

  // Regional versions. Some games are blocked in a country and replaced there by a
  // local version (for example India). `onlyInCountries`: only people in those countries
  // see this game (empty = everyone). `blockedInCountries`: people in those countries
  // don't see it. ISO codes, e.g. "IN". `localVersionOf` names the global game a local
  // version stands in for (shown to admins).
  onlyInCountries    String[] @default([])
  blockedInCountries String[] @default([])
  localVersionOf     String?

  tournaments   Tournament[]
  gameRequests  GameRequest[]
  clubRosters   ClubRoster[]
  clubInvites   ClubInvite[]
  clubTeams     ClubTeam[]
  templates     TournamentTemplate[]
  playerRatings PlayerGameRating[]
  challenges    Challenge[]
}

enum GameRequestStatus {
  pending
  approved
  rejected
}

model GameRequest {
  id             String            @id @default(uuid())
  organizerId    String
  organizer      OrganizerProfile  @relation(fields: [organizerId], references: [id])
  gameName       String
  status         GameRequestStatus @default(pending)
  reviewedById   String?
  createdAt      DateTime          @default(now())
  approvedGameId String?
  approvedGame   Game?             @relation(fields: [approvedGameId], references: [id])
}

// ------------------------------------------------------------
// ROLE PROFILES
// ------------------------------------------------------------

model PlayerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Required at the form/API level, nullable here so existing users
  // (created before these fields existed) aren't broken by a migration.
  firstName String?
  lastName  String?

  // All genuinely optional.
  mobileNumber  String?
  region        String?
  country       String?
  city          String?
  age           Int?
  // Date of birth as the player declared it (date only). Set once, never edited by the
  // player afterwards; `age` above is kept in step with it for older screens.
  birthDate     DateTime? @db.Date
  gender        String?
  hobbies       String?
  favoriteGames String[]  @default([])
  // Asked during onboarding; shown nowhere public. Null = not answered.
  playStyle     PlayStyle?
  // Set when the new-player onboarding is finished (or skipped to the end). Null means
  // they still get sent through it after signing in. Existing players are backfilled.
  onboardedAt   DateTime?

  // Chosen at sign up. Stored lowercase, so uniqueness ignores case. Null for people who
  // signed in with Google/Discord/Twitch and haven't picked one yet.
  username String? @unique

  // Sign-up records. Terms/Privacy are accepted together; the version says which text.
  termsAcceptedAt DateTime?
  termsVersion    String?
  // Marketing email is opt-in and off unless ticked; the time is kept as proof.
  marketingEmail   Boolean   @default(false)
  marketingEmailAt DateTime?
  // Under 18 at sign up: the parent/guardian email given on the form. The consent request
  // is sent from it once the player confirms their own email.
  guardianEmail String?

  registrations    Registration[]
  teamMemberships  TeamMember[]
  clubRoster       ClubRoster?
  clubInvites      ClubInvite[]
  tournamentVotes  TournamentVote[]
  gameRatings      PlayerGameRating[]
  parentalConsents ParentalConsent[]
  payoutMethod     PlayerPayoutMethod?
  institution      PlayerInstitution?

  // Subscription plan (Phase 5). Code of a Plan row; an expired paid plan
  // is treated as free at read time (lib/plans.ts), no cron needed.
  planCode      String    @default("player_free")
  planExpiresAt DateTime?

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// INSTITUTION VERIFICATION (Phase 8.1, spec §8)
// Done once per player and reused by every institution-only tournament.
// The ID image lives in a PRIVATE storage bucket; only its path is stored.
// ------------------------------------------------------------

// Who may register for a tournament (spec §8). Institution-only tournaments
// need an approved PlayerInstitution (Phase 8.1) for every player on the entry.
enum AudienceScope {
  open
  institution
}

// Where a tournament is played (spec §8). Online uses the Room ID/Password
// flow; LAN uses a venue address and on-site check-in instead of room
// credentials. Hybrid (per-stage venue) comes in 8.4.
// Role of an extra institute on an institution-scoped tournament. The host
// institute is implicit (the tournament organizer's own Institution).
//   cohost — approves/rejects registrations from ITS OWN members only
//   guest  — its members may enter, but the host approves them
enum CoHostRole {
  cohost
  guest
}

// Where a challenge application stands with the institute that has to vouch
// for the applicant. Open challenges leave every application "approved".
enum InstituteReview {
  pending
  approved
  rejected
}

enum CoHostStatus {
  pending
  accepted
  declined
}

enum VenueType {
  online
  lan
  // Venue is decided per stage (online qualifiers -> LAN finals). Stages only
  // ever use online or lan.
  hybrid
}

enum CheckInStatus {
  pending
  checked_in
  no_show
}

enum InstitutionStatus {
  pending
  approved
  rejected
}

model PlayerInstitution {
  id       String        @id @default(uuid())
  playerId String        @unique // one institute per player
  player   PlayerProfile @relation(fields: [playerId], references: [id])

  // The institute the player belongs to. Null only on legacy rows created
  // before institutes existed (free-text name below); those players must pick
  // an institute again before entering institution-only tournaments.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  institutionName String // snapshot of the name (legacy: what the player typed)
  studentId       String? // the number printed on the ID, if the player wants to add it

  // The player's STORED student ID card: added once, reused by every tournament
  // that asks for a student ID, and kept until the player removes it themself.
  // The photo is a path in the private "institution-proofs" bucket
  // (<userId>/<file>). It belongs to the institute it was uploaded for.
  idImagePath     String?
  idInstitutionId String? // the institute this ID was added for (stale if the player switches institute)
  idExpiresAt     DateTime? @db.Date // the card's printed expiry date; null = the card has none
  idUploadedAt    DateTime?

  // LEGACY 8.1 admin-review fields. New memberships are created "approved";
  // the institute, not the admin, decides entry per tournament.
  status       InstitutionStatus @default(approved)
  adminNote    String?
  reviewedById String?
  reviewedAt   DateTime?

  // Players may change institute once a week (enforced in the service).
  lastChangedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([institutionId])
}

// An entry the organizer advanced into a stage (e.g. qualifiers -> finals).
// Carries that stage's own LAN check-in state.
model StageEntry {
  id             String       @id @default(uuid())
  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  checkInStatus   CheckInStatus @default(pending)
  checkedInAt     DateTime?
  checkInAttempts Int           @default(0)

  createdAt DateTime @default(now())

  @@unique([stageId, registrationId])
  @@index([registrationId])
}

// Which catalog currencies (lib/money.ts) organizers may pick for entry fees
// and prize pools. Admin-managed on /admin/currencies. Existing tournaments
// keep their currency even if it is switched off later.
model CurrencySetting {
  code      String   @id
  enabled   Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// How the prize pool is split by finishing position (spec §2.11), e.g. 1st
// $750,000, 2nd $350,000, 4th-8th $50,000 each. `amount` is PER TEAM in the
// tournament's prize-pool currency; the whole split may not exceed the pool.
model PrizeTier {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  positionFrom Int
  positionTo   Int // same as positionFrom for a single place
  amount       Decimal @db.Decimal(14, 2)

  @@index([tournamentId])
}

// A prize split as saved in a template — same shape as PrizeTier. Copied onto
// a new tournament when the template is applied (never linked).
model TemplatePrizeTier {
  id         String             @id @default(uuid())
  templateId String
  template   TournamentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  positionFrom Int
  positionTo   Int // same as positionFrom for a single place
  amount       Decimal @db.Decimal(14, 2)

  @@index([templateId])
}

model OrganizerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orgName     String
  // Admin override: skips the new-organizer starter limits (NOT the payout
  // hold). See lib/services/organizer-trust.ts.
  limitsLifted Boolean @default(false)
  deposits     SecurityDeposit[]
  identity     IdentityVerification?
  bio         String?
  socialLinks Json?

  // Subscription plan (Phase 5) — see PlanHolder in lib/plans.ts. Approval of
  // an organization application always starts on the free plan; a paid plan
  // the applicant picked is bought afterwards on /plans.
  planCode      String    @default("organizer_free")
  planExpiresAt DateTime?

  // Same free-text convention as PlayerProfile.country/region. Used to
  // resolve which CompetitiveTierSetting applies to this organizer's
  // tournaments (country match > region match > world default — spec §9,
  // "admin can set it by country, region, or world").
  country String?
  region  String?

  tournaments    Tournament[]
  gameRequests   GameRequest[]
  templates      TournamentTemplate[]
  members        OrganizationMember[]
  featuredSlides FeaturedSlide[]
  institution    Institution?

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// ORGANIZATION REGISTRATION (admin-reviewed)
// ------------------------------------------------------------

enum OrgApplicationStatus {
  pending
  approved
  rejected
}

enum OrgMemberRole {
  manager
  staff
}

// An organization's request to join the platform. One row per account —
// a rejected applicant edits and resubmits THIS row (attemptCount goes up)
// rather than creating a new one. The OrganizerProfile is only created when
// an admin approves, so a pending/rejected applicant has no organizer access.
model OrganizationApplication {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orgName     String
  // Lowercased, letters+digits only ("Falcon Esports!" -> "falconesports").
  // Unique so two organizations can't hold near-identical names.
  orgNameKey  String @unique
  orgType     String
  description String

  registrationNumber String?
  website            String?
  country            String
  city               String
  address            String
  contactEmail       String
  contactPhone       String

  // The person running the organization's account.
  handlerName  String
  handlerRole  String
  handlerPhone String

  // Code of the Plan row the applicant picked (e.g. "organizer_pro"). Only
  // a preference: nothing is granted until they pay on /plans.
  plan   String               @default("organizer_free")
  status OrgApplicationStatus @default(pending)

  attemptCount   Int       @default(1) // how many times it has been submitted
  rejectionCount Int       @default(0)
  rejectionNote  String? // admin's overall message
  fieldFeedback  Json? // { fieldName: "what to fix" }
  nextResubmitAt DateTime? // set on rejection: 2h, then 24h, then 7d

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// People an approved organization adds to help run it. Added by email; if
// that email already has an account, userId is linked.
model OrganizationMember {
  id          String           @id @default(uuid())
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])

  email String
  name  String?
  role  OrgMemberRole @default(staff)

  createdAt DateTime @default(now())

  @@unique([organizerId, email])
}

// ------------------------------------------------------------
// ADMIN ANALYTICS
// ------------------------------------------------------------

// One row per browsing session (not per page view): who, from where, on what
// device. Written by the session beacon, read only by the admin panel. This
// holds personal data (IP address) — disclose it in the privacy policy and
// purge old rows with purgeOldVisits() in lib/services/analytics.ts.
model VisitSession {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  ip         String?
  country    String? // ISO code, e.g. "PK"
  region     String?
  city       String?
  deviceType String // desktop | mobile | tablet | unknown
  os         String?
  browser    String?
  path       String
  referrer   String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([country])
}

enum PaymentKind {
  club_upgrade
  org_plan
  player_plan
  other
}

// A manual ledger of money the PLATFORM received (paid club plans, organization
// plans). There is no payment gateway yet, so an admin records each payment —
// club upgrades are recorded when the admin approves the payment proof.
model PaymentRecord {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation("Payer", fields: [userId], references: [id])
  kind   PaymentKind

  amount    Decimal @db.Decimal(14, 2)
  currency  String
  method    String // "JazzCash", "Bank transfer", …
  reference String?
  note      String?

  recordedById String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ------------------------------------------------------------
// CLUB NAME PROTECTION + ACCOUNT BANS
// ------------------------------------------------------------

// A ban blocks the whole account EXCEPT logging in: a banned user signs in
// and is shown the reason plus how to contact support. endsAt = null means
// permanent. History is kept; "active" = not lifted and not expired.
model AccountBan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("BannedUser", fields: [userId], references: [id])

  reason      String
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdById String
  liftedAt    DateTime?
  liftedById  String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum ClubNameClaimStatus {
  pending
  upheld
  dismissed
}

// Someone says "that club is using MY name". If an admin upholds it, the
// squatting club is disbanded, its owner is banned for the duration the
// admin picks, and the name is held for the claimant until they use it.
model ClubNameClaim {
  id         String @id @default(uuid())
  claimantId String
  claimant   User   @relation("ClaimantUser", fields: [claimantId], references: [id])

  nameKey  String // the contested name, normalized
  clubName String // as typed in the claim
  clubId   String? // the club holding the name when the claim was filed

  explanation String
  evidenceUrl String?

  status       ClubNameClaimStatus @default(pending)
  adminNote    String?
  banDays      Int? // what the admin chose on upholding; null = permanent
  reviewedById String?
  reviewedAt   DateTime?

  // Set when the claimant actually creates the club/organization with the
  // name. Until then the name is reserved for them.
  fulfilledAt DateTime?

  createdAt DateTime @default(now())

  @@index([nameKey])
  @@index([claimantId])
}

// ------------------------------------------------------------
// TOURNAMENT TEMPLATES (Phase 3)
// ------------------------------------------------------------

// Saves a tournament's whole reusable config — everything EXCEPT
// instance-specific fields (date, room credentials) — spec §5. "Start from
// Template" pre-fills the new-tournament form from this; the organizer edits
// whatever changed before creating. Rules and stages copied INTO a new
// tournament are that tournament's own rows from then on — editing or
// deleting the template later never touches a tournament already created
// from it, same snapshot rule as SuggestedRule (spec §5).
model TournamentTemplate {
  id          String           @id @default(uuid())
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])
  name        String

  gameId         String
  game           Game             @relation(fields: [gameId], references: [id])
  type           TournamentType
  mode           TournamentMode
  maxTeamSize    Int?
  maxTeams       Int
  playersPerRoom Int?
  format         TournamentFormat

  entryType           EntryType
  entryFeeAmount      Decimal?  @db.Decimal(14, 2)
  entryFeeCurrency    String?
  paymentInstructions String?
  prizePoolAmount     Decimal?  @db.Decimal(14, 2)
  prizePoolCurrency   String?

  audienceScope                AudienceScope @default(open)
  requireFreshInstitutionProof Boolean       @default(false)
  venueType                    VenueType     @default(online)

  // Same shape as Tournament.customFields — an array of {key, label, type,
  // required}. Copied as-is into a new tournament.
  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules      TemplateRule[]
  stages     TemplateStage[]
  prizeTiers TemplatePrizeTier[]
}

// A rule as saved in a template — same shape as TournamentRule (spec §5's
// "rule set"), minus stage scoping (a template's stages are just names, not
// real Stage rows yet, so there is nothing to scope to until the tournament
// exists).
model TemplateRule {
  id         String             @id @default(uuid())
  templateId String
  template   TournamentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title         String?
  description   String
  action        RuleAction @default(warning)
  penaltyPoints Int?
  position      Int        @default(0)

  // Provenance only, same as TournamentRule.suggestedRuleId.
  suggestedRuleId String?
  suggestedRule   SuggestedRule? @relation(fields: [suggestedRuleId], references: [id], onDelete: SetNull)
}

// A stage NAME and order only — a real Stage also has a date and room
// credentials, which are instance-specific and never saved in a template.
model TemplateStage {
  id         String             @id @default(uuid())
  templateId String
  template   TournamentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int
}

// ------------------------------------------------------------
// CLUB MODULE (Phase 2)
// ------------------------------------------------------------

// Mirrors the organizer approval pattern: club signs up, pays the
// registration fee (screenshot proof), admin approves.
enum ClubStatus {
  pending
  approved
  rejected
  // Taken down after an upheld name claim. The row is kept for history but
  // the club can no longer act (every club feature requires "approved").
  disbanded
}

// Clubs are created instantly and free. A PAID plan needs a registration-fee
// payment proof that an admin verifies; this tracks that upgrade request.
enum ClubUpgradeStatus {
  none
  pending
  rejected
}

model ClubProfile {
  id     String @id @default(uuid())
  userId String @unique // club owner account
  user   User   @relation(fields: [userId], references: [id])

  clubName String
  logoUrl  String?

  status      ClubStatus @default(approved)
  feeProofUrl String? // screenshot of the PAID-plan fee payment (upgrade only)

  // Normalized name (see lib/org-name.ts) — unique, so "Falcon" and
  // "falcon!" can't both exist. Cleared when a club is disbanded so the
  // rightful owner can take the name. Null on clubs created before this
  // existed; lib/services/club-names.ts checks those by scanning.
  nameKey        String?         @unique
  featuredSlides FeaturedSlide[]

  upgradeStatus ClubUpgradeStatus @default(none)
  disbandedAt   DateTime?
  disbandReason String?

  // Subscription plan (Phase 5): code of a Plan row. Limits come from that
  // row via lib/club-limits.ts; an expired paid plan counts as free.
  subscriptionPlanCode String    @default("club_free")
  planExpiresAt        DateTime?

  teams       ClubTeam[]
  roster      ClubRoster[]
  invites     ClubInvite[]
  teamEntries TeamEntry[]

  createdAt DateTime @default(now())
}

// A named team a club fields in a team game (e.g. "Alpha" and "Bravo" in
// PUBG Mobile). Solo games (Tekken, Chess...) have no ClubTeam — those
// roster members simply have teamId = null.
// How many teams a club may have per game is a subscription limit
// (Phase 5), enforced in the service layer, not here.
model ClubTeam {
  id     String      @id @default(uuid())
  clubId String
  club   ClubProfile @relation(fields: [clubId], references: [id])
  gameId String
  game   Game        @relation(fields: [gameId], references: [id])
  name   String

  // Plain text — set by the club owner, paid clubs only (Phase 5 gate).
  // No uniqueness: the same coach name can appear on any club/team.
  coachName String?

  // Per-game team rating (spec §9) — a club team persists across
  // tournaments (unlike an ad-hoc non-club squad, which has no identity
  // once its one tournament ends), so it's the only "team" that can
  // meaningfully carry a rating rather than each member's individual one.
  rating Int @default(1000)

  members               ClubRoster[]
  invites               ClubInvite[]
  entries               TeamEntry[]
  challengeApplications ChallengeApplication[]

  createdAt DateTime @default(now())

  @@unique([clubId, gameId, name])
  @@index([clubId, gameId])
}

// Coaches are NOT roster members — they're just a plain name on the team
// (ClubTeam.coachName), no account or invite involved.
enum ClubRosterRole {
  player
  substitute
}

// Permanent roster. A person is on AT MOST ONE club's roster, in ONE
// game, in ONE role (and on one team, for team games) — enforced by the
// unique constraint on playerId. Rows are only created by accepting a
// ClubInvite (never inserted directly), and accepting replaces any
// existing row for that person in one transaction.
// Invariant kept in the service layer: if teamId is set, gameId must
// equal the team's gameId and clubId the team's clubId.
// Editable anytime — the per-tournament roster lock lives on the
// tournament's TeamEntry/TeamMember rows, not here.
model ClubRoster {
  id        String         @id @default(uuid())
  clubId    String
  club      ClubProfile    @relation(fields: [clubId], references: [id])
  playerId  String         @unique
  player    PlayerProfile  @relation(fields: [playerId], references: [id])
  gameId    String
  game      Game           @relation(fields: [gameId], references: [id])
  teamId    String? // null for solo games
  team      ClubTeam?      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  role      ClubRosterRole @default(player)
  // Only meaningful when teamId is set. The captain, along with the club
  // owner, may submit/edit this team's tournament entries. At most one
  // captain per team — enforced in the service layer (setTeamCaptain).
  isCaptain Boolean        @default(false)
  joinedAt  DateTime       @default(now())

  @@index([clubId, gameId])
  @@index([teamId])
}

enum ClubInviteStatus {
  pending
  accepted
  declined
  cancelled // club withdrew it before the player responded
}

// A club invites a person to its roster for a specific game (and team +
// role, for team games). Kept as history (never deleted).
// "One pending invite per (club, player)" is enforced in the service layer.
model ClubInvite {
  id       String           @id @default(uuid())
  clubId   String
  club     ClubProfile      @relation(fields: [clubId], references: [id])
  playerId String
  player   PlayerProfile    @relation(fields: [playerId], references: [id])
  gameId   String
  game     Game             @relation(fields: [gameId], references: [id])
  teamId   String?
  team     ClubTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  role     ClubRosterRole   @default(player)
  status   ClubInviteStatus @default(pending)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([playerId, status])
  @@index([clubId, status])
}

// ------------------------------------------------------------
// TOURNAMENT CORE
// ------------------------------------------------------------

enum TournamentType {
  tournament
  league
  scrim
}

enum TournamentMode {
  solo
  duo
  squad
}

enum TournamentFormat {
  single_elimination
  double_elimination
  round_robin
  points_table
  league_format
}

enum EntryType {
  free
  paid
}

enum TournamentStatus {
  draft
  published
  registration_open
  registration_closed
  in_progress
  completed
  cancelled
}

// Enforced by CompetitiveTierSetting (the admin-configurable ladder),
// PlayerGameRating/ClubTeam.rating (the rating engine), and the
// resolveTierSetting/checkTierEntryGate functions in
// lib/services/competitive-tiers.ts — see Phase 6.
enum CompetitiveTier {
  none
  D
  C
  B
  A
  S
  National
}

// Admin-configurable tier ladder (spec §9) — never hardcoded. One row per
// (tier, scope) combination; "world" is the mandatory fallback so every
// tier always resolves to *something* even where no country/region
// override has been set. Resolution order when gating a tournament or a
// registration: the organizer's country, then their region, then world.
model CompetitiveTierSetting {
  id String @id @default(uuid())

  tier       CompetitiveTier // never "none" — that's "not competitive", not a tier
  scope      TierSettingScope
  // Country/region name, matched against OrganizerProfile.country/region
  // (case-insensitive, exact match). Null when scope is "world".
  scopeValue String?

  minPrizePoolUsd Decimal @db.Decimal(14, 2)
  // Rating gate for D/C/B/A/S — null for D and C (spec: "None / light
  // floor"). Not used for National, which gates on minWins instead.
  minRating       Int?
  // National-only: "5+ S-tier wins" — a completed-tournament win count,
  // not a rating threshold (see getNationalEligibility).
  minWins         Int?

  publishPath TierPublishPath @default(instant)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tier, scope, scopeValue])
}

enum TierSettingScope {
  world
  region
  country
}

enum TierPublishPath {
  instant
  // B/A per spec are "Instant (auto-checked)" — same publishPath as D/C
  // from the settings' point of view (no human review), the "auto-checked"
  // part is just the rating-gate check the registration flow already does.
  admin_review
  always_admin
}

// Per-game player rating (spec §9: "per-game — never blended into one
// number"). Only moves from Tournament results, never Leagues/Scrims.
// Baseline 1000 is an arbitrary starting point, easy to change later —
// what matters per spec is relative movement, not the absolute number.
model PlayerGameRating {
  id       String        @id @default(uuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id])
  gameId   String
  game     Game          @relation(fields: [gameId], references: [id])

  // One rating per mode: someone's solo form says nothing about their squad play, so each
  // tournament mode keeps its own number (rankings and tier gates read the matching one).
  mode   TournamentMode
  rating Int @default(1000)

  updatedAt DateTime @updatedAt

  @@unique([playerId, gameId, mode])
  @@index([gameId, mode, rating])
}

model Tournament {
  id          String           @id @default(uuid())
  slug        String           @unique
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])
  gameId      String
  game        Game             @relation(fields: [gameId], references: [id])

  name        String
  description String?
  bannerUrl   String?

  type           TournamentType
  mode           TournamentMode
  maxTeamSize    Int?
  maxTeams       Int
  playersPerRoom Int?
  format         TournamentFormat

  entryType           EntryType
  entryFeeAmount      Decimal?  @db.Decimal(14, 2)
  entryFeeCurrency    String?
  // Free text: "JazzCash 0300-1234567 (Ali)", "Bank transfer to ...", etc.
  // Shown to the player on the join page, above the payment-proof upload,
  // so they know where to actually send money before being asked to prove
  // they sent it. Only meaningful when entryType is "paid".
  paymentInstructions String?

  prizePoolAmount   Decimal? @db.Decimal(14, 2)
  prizePoolCurrency String?
  // Organizer-confirmed that prize money actually went out (spec §10).
  // Only payout-confirmed prize pools count toward the organizer's public
  // "Total Prize Pool Distributed".
  payoutConfirmed   Boolean  @default(false)
  // Set when the tournament moves to completed; starts the payout grace
  // period (see lib/services/organizer-trust.ts). Null on older rows.
  completedAt       DateTime?
  prizePayouts      PrizePayout[]
  // Set when an admin-approved cancellation leaves paid players owed refunds:
  // the organizer must refund them directly and confirm by this date.
  cancelRefundsDueAt DateTime?
  refundsConfirmedAt DateTime?
  // True once this event was locked (paid/prized with a registered player).
  // Keeps the promise to its players even if the lock switch is turned off.
  lockEnforced      Boolean  @default(false)
  changeRequests    TournamentChangeRequest[]
  prizeAwards       PrizeAward[]

  competitiveTier CompetitiveTier @default(none)

  // ISO-3166 alpha-2 (see lib/geo-data.ts). Null = worldwide / open to anyone.
  // The broader region (South Asia, ...) is derived from this, never stored.
  country String?

  venueType       VenueType @default(online)
  venueName       String?
  venueAddress    String?
  venueCity       String?
  // LAN only. Players can self check-in inside this window by typing the code
  // the organizer shows at the venue desk; the organizer can always check
  // people in or mark no-shows by hand. checkInCode is organizer-only: it is
  // stripped from every public response.
  checkInOpensAt  DateTime?
  checkInClosesAt DateTime?
  checkInCode     String?

  audienceScope                AudienceScope @default(open)
  // Youngest allowed player: 13 (the platform floor), 16 or 18. Checked per player at
  // every way of entering; locked once anyone has registered.
  minAge                       Int           @default(13)
  // Players under 18 need a parent or guardian's consent (valid 1 year) before they get
  // room details or can check in. Only used when the platform switch is on.
  requireParentalConsent       Boolean       @default(false)
  // Institution-only tournaments only: also ask the registering player for a
  // fresh ID photo with THIS registration, on top of their verified profile.
  requireFreshInstitutionProof Boolean       @default(false)

  customFields Json?

  status             TournamentStatus @default(draft)
  // Set when an organizer tries to publish an S/National-tier tournament
  // (spec §9: "Admin review required" / "Always Admin-approved"). Tournament
  // stays "draft" — status itself is untouched — while this is true; an
  // admin approving flips status straight to "published" and clears this,
  // rejecting just clears it so the organizer can edit and resubmit. Kept
  // as a separate flag rather than a new status value so nothing else that
  // reads TournamentStatus (registration gating, capacity checks, etc.)
  // needs to learn about a new in-between state.
  submittedForReview Boolean          @default(false)
  startAt            DateTime?

  // Basic shareable-link tracking (spec §3) — incremented on a real page
  // view and on a successful registration.
  clickCount        Int @default(0)
  registrationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages                 Stage[]
  prizeTiers             PrizeTier[]
  rules                  TournamentRule[]
  registrations          Registration[]
  institutions           TournamentInstitution[]
  // Default cap on entries per institute (institution-only tournaments). Null = no cap.
  maxEntriesPerInstitute Int?
  // What happens to an entry reported as a no-show (decided by the organizer).
  noShowPenalty          NoShowPenalty           @default(none)
  noShowPenaltyPoints    Int? // only for point_deduction
  penalties              Penalty[]
  flags                  TournamentFlag[]
  teamEntries            TeamEntry[]
  votes                  TournamentVote[]
  featured               FeaturedTournament?

  @@index([audienceScope])
  @@index([venueType])
  @@index([country])
}

// One like/dislike per player per tournament, and only if they actually
// joined (spec §10).
model TournamentVote {
  id           String        @id @default(uuid())
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId], references: [id])
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id])
  value        VoteValue

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, playerId])
}

enum VoteValue {
  like
  dislike
}

model Stage {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  name  String
  order Int

  startAt      DateTime?
  roomId       String?
  roomPassword String?
  roomRevealAt DateTime?

  status String @default("upcoming")

  // Venue per stage (Phase 8.4). Only meaningful when the tournament is
  // hybrid; otherwise stages follow the tournament's own venue.
  venueType       VenueType @default(online)
  venueName       String?
  venueAddress    String?
  venueCity       String?
  checkInOpensAt  DateTime?
  checkInClosesAt DateTime?
  checkInCode     String? // organizer-only, LAN stages
  // true = only entries the organizer advanced into this stage may use its
  // room / check in. LAN stages of a hybrid tournament are always restricted.
  restricted      Boolean   @default(false)

  entries StageEntry[]

  rules TournamentRule[]
}

// Phase 1: simple free-text rules. Structured type/severity + rule sets
// + templates are Phase 3 — see schema.full.prisma.
// What happens when a rule is broken.
enum RuleAction {
  warning
  point_deduction
  disqualification
}

// The catalog behind the "+" button when an organizer adds rules. This is
// DATA, not code: admins add/edit/hide suggestions from the admin panel and
// nothing in the app depends on any particular one existing. Adding one to a
// tournament COPIES it into a TournamentRule, so editing or deleting a
// suggestion later never changes a tournament that already has it (spec §5).
model SuggestedRule {
  id            String     @id @default(uuid())
  title         String
  description   String
  action        RuleAction @default(warning)
  penaltyPoints Int? // only for point_deduction
  // Matches Game.category ("mobile", "pc", ...). null = suggested for every game.
  gameCategory  String?
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  tournamentRules TournamentRule[]
  templateRules   TemplateRule[]
}

// A rule as it applies to ONE tournament — its own snapshot, whether it
// started as a suggestion or was written by the organizer.
model TournamentRule {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  description  String

  // Short name ("No emulators"). Optional so rules that predate this (plain
  // text) keep working — those show just their description.
  title         String?
  action        RuleAction @default(warning)
  penaltyPoints Int? // required when action is point_deduction, otherwise null
  position      Int        @default(0) // display order

  // Optional: the rule only applies to one stage (e.g. Finals).
  appliesToStageId String?
  appliesToStage   Stage?  @relation(fields: [appliesToStageId], references: [id])

  // Where it was copied from, if it was a suggestion. Provenance only.
  suggestedRuleId String?
  suggestedRule   SuggestedRule? @relation(fields: [suggestedRuleId], references: [id], onDelete: SetNull)

  disqualifications Registration[] @relation("DisqualifiedRule")
}

// ------------------------------------------------------------
// REGISTRATION & TEAMS
// ------------------------------------------------------------

enum RegistrationStatus {
  pending
  approved
  rejected
  disqualified
}

enum PaymentStatus {
  unpaid
  paid
  waived
}

enum AddedBy {
  self
  organizer
}

model TeamEntry {
  id           String       @id @default(uuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  name         String
  clubId       String?
  club         ClubProfile? @relation(fields: [clubId], references: [id])
  // Which permanent ClubTeam this entry represents, if any. Lets the club
  // find/edit "our entry for team X in tournament Y", and distinguishes a
  // club entry from an ad-hoc team a non-club player formed at registration.
  clubTeamId   String?
  clubTeam     ClubTeam?    @relation(fields: [clubTeamId], references: [id])

  members      TeamMember[]
  registration Registration?
}

model TeamMember {
  id          String        @id @default(uuid())
  teamEntryId String
  teamEntry   TeamEntry     @relation(fields: [teamEntryId], references: [id])
  playerId    String
  player      PlayerProfile @relation(fields: [playerId], references: [id])
}

model Registration {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  playerId    String?
  player      PlayerProfile? @relation(fields: [playerId], references: [id])
  teamEntryId String?        @unique
  teamEntry   TeamEntry?     @relation(fields: [teamEntryId], references: [id])

  status               RegistrationStatus @default(pending)
  paymentStatus        PaymentStatus      @default(unpaid)
  paymentProofUrl      String?
  // Private-bucket path of the per-tournament ID photo (see
  // Tournament.requireFreshInstitutionProof). Never exposed as a public URL.
  institutionProofPath String?

  // Which institute's queue this registration belongs to (the player's — or,
  // for a team, the shared — institute at registration time). Null = the host
  // handles it. A co-host acts only on registrations routed to its institute.
  routedInstitutionId     String?
  routedInstitution       Institution? @relation("RoutedRegistration", fields: [routedInstitutionId], references: [id])
  // The ONE institute this entry plays for (every player on a team shares it).
  // Set for institution-only tournaments; counts against the institute's quota.
  institutionId           String?
  institution             Institution? @relation("EntryInstitution", fields: [institutionId], references: [id])
  // Which institute took responsibility by approving the entry (host or co-host).
  approvedByInstitutionId String?
  // Set when a co-host approved eligibility on a PAID tournament; the host
  // still confirms payment before the registration becomes approved.
  institutionApprovedAt   DateTime?

  // LAN check-in (a team entry checks in as one unit).
  checkInStatus   CheckInStatus @default(pending)
  checkedInAt     DateTime?
  checkInAttempts Int           @default(0) // wrong-code tries; locks self check-in at 5
  stageEntries    StageEntry[]
  addedBy         AddedBy       @default(self)

  disqualifiedRuleId          String?
  disqualifiedRule            TournamentRule? @relation("DisqualifiedRule", fields: [disqualifiedRuleId], references: [id])
  disqualifiedReason          String?
  disqualifiedAt              DateTime?
  disqualifiedByUserId        String?
  disqualifiedByInstitutionId String? // the host's or a co-host institute's id, when one of them did it
  penalties                   Penalty[]

  customFieldResponses Json?

  // Results/standings — set by the organizer once a tournament has matches
  // to report. Nullable: most registrations never get a placement (only
  // those who actually finished/placed do), and points is separate from
  // placement since some formats (points-table, league) rank by points
  // rather than a single final placement.
  placement Int?
  prizePayout PrizePayout?
  points    Int?

  registeredAt DateTime  @default(now())
  approvedAt   DateTime?

  // Quota counts ask "how many live entries does this institute have in this tournament".
  @@index([tournamentId, institutionId])

  // Set when a guardian withdrew consent while this entry was in a tournament already running.
  consentCase ConsentCase?
}

model SiteSettings {
  id                      String   @id @default("singleton")
  logoUrl                 String?
  // Shown on the club registration form: amount + where to send the fee.
  clubPaymentInstructions String?
  // Shown on the plan-upgrade form: where to send the plan payment.
  planPaymentInstructions String?
  // Ads stay off until an ad network is wired into components/ui/AdSlot.
  adsEnabled              Boolean  @default(false)
  // A challenge whose cash prize (in USD) is above this waits for admin
  // approval before it goes live. Plan caps (Plan.limits) apply first.
  challengeReviewUsd      Decimal  @default(10000) @db.Decimal(14, 2)
  // "Continue with Twitch" on the login/sign-up pages. Off until the Twitch app and the
  // Supabase provider are set up (see SETUP.md), then switched on from Admin > Settings.
  twitchLoginEnabled      Boolean  @default(false)
  // Security deposit on organizer plans. depositEnabled shows the deposit on
  // plans and requires it on NEW purchases; deposits already held keep their
  // effect and stay refundable when it is off.
  depositEnabled          Boolean  @default(false)
  depositRefundDays       Int      @default(30)
  // Live paid/prized events may total up to (held deposit in USD) x this.
  depositExposureMultiplier Decimal @default(5) @db.Decimal(6, 2)

  // ---- Feature switches (Admin > Settings > Features). Existing behaviour is
  // the default; "off" means NEW things stop following the feature, while
  // promises already made to players (locked events, held deposits, existing
  // consents) are kept. See lib/services/feature-flags.ts.
  organizerTrustEnabled   Boolean  @default(true)
  tournamentLockEnabled   Boolean  @default(true)
  prizeBreakdownRequired  Boolean  @default(true)
  specialAwardsEnabled    Boolean  @default(true)
  entryConditionsEnabled  Boolean  @default(true)
  challengesEnabled       Boolean  @default(true)
  // null = follow NEXT_PUBLIC_PARENTAL_CONSENT_ENABLED (the old env switch), so
  // existing deployments don't change until an admin flips it here.
  guardianConsentEnabled  Boolean?
  updatedAt               DateTime @updatedAt
}

// ------------------------------------------------------------
// CHALLENGES
// ------------------------------------------------------------

enum ChallengePosterType {
  organizer
  club
  player
}

// Who may take the challenge on.
enum ChallengeEntrantType {
  player
  team
  either
}

enum ChallengePrizeType {
  cash // money, paid by the poster directly (the platform never holds funds)
  in_game // in-game currency/items, e.g. "600 UC", delivered to the winner
  reward // anything else, e.g. free entry to the poster's scrim or league
}

enum ChallengeStatus {
  pending_review // over the admin-review prize threshold; not public yet
  open // accepting applications
  in_progress // challenger(s) chosen, playing
  completed
  expired // nobody was chosen before the deadline
  cancelled
  rejected // admin declined it
  removed // taken down by an admin after reports
}

// A poster (organization, club or player on a plan that allows it) offers a
// prize to whoever beats them / completes a task. Posting is capped by the
// poster's plan (count per month, prize size) — see lib/services/challenges.ts.
model Challenge {
  id           String              @id @default(uuid())
  posterUserId String
  poster       User                @relation("ChallengePoster", fields: [posterUserId], references: [id])
  posterType   ChallengePosterType
  // Snapshot of the organization / club / player name at posting time.
  posterName   String

  title       String
  description String // the rules: what has to be done to win
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id])

  entrantType ChallengeEntrantType @default(either)
  // Applicants need at least this rating in the game (Phase 6 ratings).
  minRating   Int?

  // How many challengers the poster will pick, and how many applications are
  // accepted before the challenge stops taking more (anti-flooding).
  slots               Int
  maxApplicants       Int
  applicationsCloseAt DateTime
  // How long the chosen challenger(s) have to complete it, set by the poster.
  completeWithinDays  Int

  prizeType        ChallengePrizeType
  prizeDescription String // e.g. "600 UC", "Free entry to our weekend scrim"
  cashAmount       Decimal?           @db.Decimal(14, 2)
  cashCurrency     String?
  // USD value used for plan caps and the review threshold: converted from
  // the cash amount, or the poster's estimate for in-game prizes.
  prizeUsd         Decimal?           @db.Decimal(14, 2)
  // How the poster will pay/deliver (e.g. "JazzCash or bank transfer, PKR").
  payoutMethod     String

  status       ChallengeStatus        @default(open)
  // Set when the poster confirms their pick: the chosen challenger(s) must
  // finish by completeBy (selectedAt + completeWithinDays).
  selectedAt   DateTime?
  completeBy   DateTime?
  applications ChallengeApplication[]
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  // When the poster ticked "I understand" on the prize / payment terms.
  // Institution-only challenges (organization posters with a verified institute):
  // only players/teams of participating institutes may apply, and each applicant
  // is approved by their own institute before the poster can pick them.
  audienceScope               AudienceScope          @default(open)
  // Default cap on applications per institute (null = no cap).
  maxApplicationsPerInstitute Int?
  institutions                ChallengeInstitution[]

  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports ChallengeReport[]

  @@index([status, createdAt])
  @@index([posterUserId, posterType, createdAt])
  @@index([gameId])
}

model AuthCarouselSlide {
  id        String   @id @default(uuid())
  mediaUrl  String
  mediaType String // "image" | "video"
  title     String?
  text      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// ADMIN / AUDIT — minimal Phase 1 panel
// ------------------------------------------------------------

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminActor", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  notes      String?
  createdAt  DateTime @default(now())
}

// Lightweight moderation stub — any authenticated user can flag a
// tournament with a reason; admin reviews the queue. Full dispute system
// with resolution workflow is Phase 7, this is just a signal + queue.
model TournamentFlag {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  reporterId   String
  reason       String
  resolved     Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

// ------------------------------------------------------------
// SUBSCRIPTION PLANS (Phase 5)
// ------------------------------------------------------------

enum PlanAudience {
  organizer
  club
  player
}

// Admin-editable plan definitions (spec §7). `limits` is a JSON object whose
// shape depends on `audience` — see lib/plans.ts for the keys and defaults.
// Limits are convenience/cosmetic only; free plans never gate anything
// competitive (joining, rating, tier eligibility).
model Plan {
  code          String       @id // e.g. "organizer_free", "club_pro"
  audience      PlanAudience
  name          String
  isPaid        Boolean      @default(false)
  priceAmount   Decimal?     @db.Decimal(14, 2)
  priceCurrency String?
  durationDays  Int          @default(30)
  limits        Json         @default("{}")
  // Refundable security deposit (same currency as the price). Only applies
  // when SiteSettings.depositEnabled is on. Never includes fees or tax.
  depositAmount Decimal?     @db.Decimal(14, 2)
  // Admin-defined extra fields (PlanField): { [fieldId]: value }. Display-only.
  extras        Json         @default("{}")
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)

  requests PlanRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, sortOrder])
}

enum PlanRequestStatus {
  pending
  approved
  rejected
}

// An account asks to move to a paid plan and uploads payment proof (same
// screenshot-proof flow as club registration). An admin approves or rejects.
model PlanRequest {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  audience   PlanAudience
  planCode   String
  plan       Plan              @relation(fields: [planCode], references: [code])
  proofUrl   String
  // Refundable deposit the requester was told to include with this payment.
  depositAmount Decimal? @db.Decimal(14, 2)
  status     PlanRequestStatus @default(pending)
  adminNote  String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId, audience])
}

// ------------------------------------------------------------
// FEATURED CONTENT (admin-curated)
// ------------------------------------------------------------

// Slides in the big carousel at the top of dashboards. A slide may belong to
// an organization or a club: it is only shown while that account's plan has
// the `dashboardCarousel` perk (so the edge ends when the plan lapses).
// A slide with neither is a platform announcement and always shows.
model FeaturedSlide {
  id          String            @id @default(uuid())
  imageUrl    String
  title       String
  text        String?
  linkUrl     String?
  organizerId String?
  organizer   OrganizerProfile? @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  clubId      String?
  club        ClubProfile?      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  isActive    Boolean           @default(true)
  position    Int               @default(0)
  createdAt   DateTime          @default(now())

  @@index([isActive, position])
}

// The admin's hand-picked "upcoming tournaments" list.
model FeaturedTournament {
  id           String     @id @default(uuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
}

enum ChallengeApplicationStatus {
  applied
  selected
  not_selected // another challenger was picked, or the challenge was cancelled
  withdrawn
}

enum ChallengeStage {
  playing // picked; must submit proof before the challenge deadline
  proof_review // proof sent; poster has 48h to confirm or dispute (silence = confirmed)
  proof_disputed // poster disputed the proof; an admin decides
  awaiting_payout_details // win confirmed; challenger adds where to send the prize
  awaiting_payment // poster has 72h to pay/deliver and upload the receipt
  payment_sent // poster says paid; challenger confirms (silence for 5 days = received)
  payment_disputed // "not received" / "never paid"; poster has 24h to show proof
  completed
  failed // no proof in time, proof rejected, or no payout details
}

enum ChallengeDisputeKind {
  proof // poster disputes the challenger's proof of winning
  payment // challenger says the prize was not paid / not received
}

enum ChallengeDisputeStatus {
  awaiting_response // the other side has 24h to answer
  awaiting_admin // answered, or the 24h passed: an admin decides
  resolved
}

enum ChallengeDisputeOutcome {
  for_challenger
  for_poster
}

enum ChallengeEntrantKind {
  player
  team
}

// One application per account per challenge. A club owner applies with one of
// the club's teams; a player applies as themselves. Rating is a snapshot so
// the poster sees what the applicant had when they applied.
model ChallengeApplication {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  applicantUserId String
  applicant       User   @relation("ChallengeApplicant", fields: [applicantUserId], references: [id])

  kind        ChallengeEntrantKind
  clubTeamId  String?
  clubTeam    ClubTeam?            @relation(fields: [clubTeamId], references: [id])
  entrantName String // player display name, or "Team name (Club name)"
  rating      Int
  message     String?

  status    ChallengeApplicationStatus @default(applied)
  decidedAt DateTime?

  // ---- Once picked (status = selected): proof -> payment -> done. `stage`
  // says where the entry is and `stageDeadline` when the current step lapses.
  stage              ChallengeStage     @default(playing)
  stageDeadline      DateTime?
  // The win: a match/game ID and screenshots (result + match history).
  matchId            String?
  proofUrls          String[]
  proofNote          String?
  proofSubmittedAt   DateTime?
  // Where to send the prize. Shown only to the poster, and erased once the
  // entry completes or fails.
  payoutDetails      String?
  // The poster's receipt (cash) or delivery screenshot (in-game / reward).
  paymentReceiptUrls String[]
  paymentNote        String?
  paymentSentAt      DateTime?
  // An admin ruled the poster owes the prize: keeps their account frozen
  // until it's paid.
  paymentOwed        Boolean            @default(false)
  completedAt        DateTime?
  failedReason       String?
  disputes           ChallengeDispute[]

  // Institution-only challenges: the ONE institute the entrant plays for (a
  // team's players all share it), whose queue it sits in (null = the host's),
  // and whether that institute has vouched for the applicant yet.
  institutionId           String?
  institution             Institution?    @relation("ChallengeAppEntry", fields: [institutionId], references: [id])
  routedInstitutionId     String?
  routedInstitution       Institution?    @relation("ChallengeAppRouted", fields: [routedInstitutionId], references: [id])
  institutionReview       InstituteReview @default(approved)
  approvedByInstitutionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, applicantUserId])
  @@index([challengeId, institutionId])
  @@index([challengeId, status])
  @@index([applicantUserId])
}

// In-app notifications (the project sends no email): applications, picks,
// and — in the next parts — proof, payment and dispute deadlines.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type  String
  title String
  body  String?
  href  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// A disagreement over one entry: either the poster doubts the proof, or the
// challenger says the prize never arrived. The side being accused gets 24h to
// answer with evidence; then an admin decides. For payment disputes the poster
// is frozen (can't post or take applications) until it is settled.
model ChallengeDispute {
  id            String               @id @default(uuid())
  applicationId String
  application   ChallengeApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  challengeId   String

  kind               ChallengeDisputeKind
  openedById         String
  reason             String
  openerEvidenceUrls String[]

  responderNote         String?
  responderEvidenceUrls String[]
  respondedAt           DateTime?
  responseDueAt         DateTime

  status         ChallengeDisputeStatus   @default(awaiting_response)
  // The accused side didn't answer in time.
  missedDeadline Boolean                  @default(false)
  outcome        ChallengeDisputeOutcome?
  adminNote      String?
  resolvedById   String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([applicationId])
  @@index([challengeId])
}

enum ChallengeReportReason {
  scam
  inappropriate
  misleading
  spam
  other
}

enum ChallengeReportStatus {
  open
  actioned // the challenge was removed
  dismissed
}

// "This challenge looks wrong." Several open reports hide a challenge from the
// list until an admin looks; an admin can then remove it or dismiss the reports.
model ChallengeReport {
  id           String                @id @default(uuid())
  challengeId  String
  challenge    Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User                  @relation(fields: [reporterId], references: [id])
  reason       ChallengeReportReason
  details      String?
  status       ChallengeReportStatus @default(open)
  adminNote    String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())

  // One report per person per challenge.
  @@unique([challengeId, reporterId])
  @@index([status, createdAt])
}

enum ChallengeFlagKind {
  same_device // poster and challenger used the same network AND browser
  same_network // the same IP address (can be a shared household / café)
  repeat_pair // the same two accounts keep being paired
}

enum ChallengeFlagStatus {
  open
  dismissed
  actioned
}

// A signal that a poster and the challenger they picked may be the same
// person or working together. Only ever shown to admins, never acted on
// automatically: shared IPs are common (families, internet cafés, mobile
// carriers), so it is a prompt to look, not proof.
model ChallengeFlag {
  id               String              @id @default(uuid())
  challengeId      String
  applicationId    String
  posterUserId     String
  challengerUserId String
  kind             ChallengeFlagKind
  details          String
  status           ChallengeFlagStatus @default(open)
  adminNote        String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())

  @@unique([applicationId, kind])
  @@index([status, createdAt])
}

// An institute (school / college / university) run by an organization.
// Admin verifies the institute once; after that the institute itself decides
// which players enter its tournaments (per tournament, not globally).
model Institution {
  id          String           @id @default(uuid())
  name        String           @unique
  organizerId String           @unique
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])

  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?

  createdAt DateTime @default(now())

  members                     PlayerInstitution[]
  tournamentLinks             TournamentInstitution[]
  routedRegistrations         Registration[]          @relation("RoutedRegistration")
  entries                     Registration[]          @relation("EntryInstitution")
  challengeLinks              ChallengeInstitution[]
  challengeApplications       ChallengeApplication[]  @relation("ChallengeAppEntry")
  routedChallengeApplications ChallengeApplication[]  @relation("ChallengeAppRouted")
  penaltiesIssued             Penalty[]               @relation("PenaltyIssuer")

  @@index([verified])
}

// Co-host / guest institutes of one tournament (see CoHostRole).
model TournamentInstitution {
  id            String       @id @default(uuid())
  tournamentId  String
  tournament    Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  role          CoHostRole
  // Guests need no acceptance (status stays accepted); co-hosts must accept.
  status        CoHostStatus @default(pending)
  invitedAt     DateTime     @default(now())
  respondedAt   DateTime?
  // Max entries (solo players or teams) this institute may have in the
  // tournament. Null = the tournament's per-institute default applies.
  maxEntries    Int?

  @@unique([tournamentId, institutionId])
  @@index([institutionId, status])
}

// Co-host / guest institutes of one institution-only challenge (see CoHostRole).
model ChallengeInstitution {
  id              String       @id @default(uuid())
  challengeId     String
  challenge       Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  institutionId   String
  institution     Institution  @relation(fields: [institutionId], references: [id])
  role            CoHostRole
  status          CoHostStatus @default(pending)
  invitedAt       DateTime     @default(now())
  respondedAt     DateTime?
  // Max applications from this institute. Null = the challenge default applies.
  maxApplications Int?

  @@unique([challengeId, institutionId])
  @@index([institutionId, status])
}

enum ParentalConsentStatus {
  pending
  approved
  declined
  revoked
  superseded
}

// A guardian's consent for one player. Covers every tournament that asks for
// parental consent until `validUntil` (one year after approval). The token in the
// email link is stored only as a hash. The waiver text the guardian saw is kept
// word for word with the signature.
model ParentalConsent {
  id       String        @id @default(uuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  guardianEmail String
  tokenHash     String                @unique
  status        ParentalConsentStatus @default(pending)

  // Context for the email only ("…to play in X"); the consent itself isn't tied to it.
  requestedFor String?

  sentAt        DateTime  @default(now())
  linkExpiresAt DateTime
  decidedAt     DateTime?
  validUntil    DateTime?

  // Link in the "you approved" email, so the guardian can come back and withdraw
  // consent or set where prizes are paid. Only its hash is stored.
  manageTokenHash String?   @unique
  revokedAt       DateTime?

  signedName      String?
  waiverVersion   String?
  waiverText      String? @db.Text
  signedIp        String?
  signedUserAgent String?

  createdAt DateTime @default(now())

  @@index([playerId, status])
}

// ------------------------------------------------------------
// PENALTIES — what happens to an entry that cheats or doesn't show up
// ------------------------------------------------------------

enum PenaltyKind {
  warning
  point_deduction
  disqualification
}

enum PenaltyCause {
  cheating
  no_show
  other
}

// What the organizer chose to do with a no-show. "none" = just record it.
enum NoShowPenalty {
  none
  warning
  point_deduction
  disqualification
}

// One consequence applied to one entry. Disqualification ALSO sets the entry's
// status; warnings and point deductions are recorded here (points are shown to
// the organizer, who enters standings by hand). Revoking keeps the row.
model Penalty {
  id             String       @id @default(uuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tournamentId   String
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  kind   PenaltyKind
  points Int? // only for point_deduction
  cause  PenaltyCause
  reason String

  issuedByUserId        String
  issuedByInstitutionId String?
  issuedByInstitution   Institution? @relation("PenaltyIssuer", fields: [issuedByInstitutionId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())

  revokedAt       DateTime?
  revokedByUserId String?

  @@index([registrationId])
  @@index([tournamentId, createdAt])
}


// ------------------------------------------------------------
// PAYOUT METHOD — how a player wants to be paid when they win a prize. Saved once,
// changeable. For a player under 18 it is the PARENT/GUARDIAN's account (entered by
// the guardian from the consent email link), and `payee` says so. The account details
// are encrypted before they are stored (lib/payout-crypto.ts) and only decrypted for
// the person who owes the prize, once a prize is actually awarded.
// ------------------------------------------------------------

enum PayoutPayee {
  self
  guardian
}

model PlayerPayoutMethod {
  id       String        @id @default(uuid())
  playerId String        @unique
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  payee     PayoutPayee @default(self)
  // Whose account it is, as written by whoever entered it (the player, or the guardian).
  payeeName String
  // "JazzCash", "Bank transfer", "PayPal", "In-game ID" ...
  method    String
  // Encrypted account number / IBAN / username / notes.
  detailsEnc String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ------------------------------------------------------------
// CONSENT CASE — a guardian withdrew consent for a player who is already playing in a
// RUNNING tournament. The entry is left alone (results stay valid) until an admin decides:
// let them finish, or remove the entry. Tournaments that haven't started never create one:
// those entries are simply cancelled.
// ------------------------------------------------------------

enum ConsentCaseStatus {
  open
  allowed
  removed
}

model ConsentCase {
  id             String       @id @default(uuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tournamentId   String
  // The child whose guardian withdrew (for a team entry, the one member).
  playerId       String

  status      ConsentCaseStatus @default(open)
  decidedById String?
  decidedAt   DateTime?
  note        String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}


// ------------------------------------------------------------
// ORGANIZER TRUST: starter limits + winner-confirmed payouts
// ------------------------------------------------------------
// New organizers start with caps on entry fee, prize pool and paid entrants.
// They graduate after enough completed prize tournaments whose winners ALL
// confirmed they were paid. Until an organizer's past payouts are settled,
// they can't host new paid or prized events. Money never moves through the
// platform: PrizePayout only records the organizer's claim and each winner's
// answer. All numbers are admin-editable (OrganizerTrustConfig), not hardcoded.

enum PayoutStatus {
  paid_by_organizer // organizer says they paid; winner hasn't answered
  confirmed         // winner (or an admin) confirmed receipt
  disputed          // winner says they were NOT paid
}

model PrizePayout {
  id             String       @id @default(uuid())
  tournamentId   String
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // A payout is either for a PLACEMENT (registrationId) or for a special AWARD
  // (awardId + recipientUserId, since an award goes to one player, not a team).
  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  awardId        String?       @unique
  award          PrizeAward?   @relation(fields: [awardId], references: [id], onDelete: SetNull)
  recipientUserId String?
  // Non-cash prize text for awards (amount is 0 for a non-cash-only award).
  description    String?

  amount   Decimal @db.Decimal(14, 2)
  currency String

  status             PayoutStatus @default(paid_by_organizer)
  organizerMarkedAt  DateTime     @default(now())
  winnerRespondedAt  DateTime?
  winnerNote         String?
  adminNote          String?

  @@index([tournamentId])
  @@index([status])
}

// Single row (id "default"), created on first read. Admin edits it at
// /admin/organizer-trust.
model OrganizerTrustConfig {
  id                    String   @id @default("default")
  starterMaxEntryFeeUsd Decimal  @default(5) @db.Decimal(10, 2)
  starterMaxPrizeUsd    Decimal  @default(100) @db.Decimal(10, 2)
  starterMaxPaidEntrants Int     @default(50)
  graduationEvents      Int      @default(3)
  // Days after completion before an unpaid/unconfirmed payout puts the
  // organizer on hold, and before an unanswered "I paid" is treated as accepted.
  payoutGraceDays       Int      @default(7)
  // Identity documents (see IdentityVerification): the MOST days the photos of
  // an approved check are kept (they go sooner once the organizer has built a
  // track record), how long a rejected one's are kept, and how long an
  // approval stays valid.
  idRetentionDays         Int    @default(365)
  idRejectedRetentionDays Int    @default(7)
  idValidityMonths        Int    @default(24)
  updatedAt             DateTime @updatedAt
}


// ------------------------------------------------------------
// PLAN CUSTOM FIELDS (admin-defined, display-only)
// ------------------------------------------------------------
model PlanField {
  id        String       @id @default(uuid())
  audience  PlanAudience
  label     String
  kind      String // "text" | "number" | "flag"
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([audience, sortOrder])
}

// ------------------------------------------------------------
// ORGANIZER SECURITY DEPOSIT
// ------------------------------------------------------------
// One lump sum paid with an organizer plan, held while they host events and
// refundable after they leave the paid plan (waiting period, no unsettled
// payouts). Fees and tax are never part of it. The platform records the
// deposit; money moves outside the system (admin refunds by bank transfer).

enum DepositStatus {
  held
  refund_requested
  refunded
  forfeited
}

model SecurityDeposit {
  id          String           @id @default(uuid())
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])
  planCode    String
  planRequestId String?        @unique

  amount   Decimal @db.Decimal(14, 2)
  currency String

  status            DepositStatus @default(held)
  heldAt            DateTime      @default(now())
  refundRequestedAt DateTime?
  refundEligibleAt  DateTime?
  resolvedAt        DateTime?
  resolvedById      String?
  refundedAmount    Decimal?      @db.Decimal(14, 2)
  forfeitedAmount   Decimal?      @db.Decimal(14, 2)
  adminNote         String?

  @@index([organizerId, status])
  @@index([status, refundEligibleAt])
}


// ------------------------------------------------------------
// TOURNAMENT LOCK + ADMIN CHANGE REQUESTS
// ------------------------------------------------------------
// Once a paid or prized tournament, scrim or league has an active
// registration, its prize pool, cancellation and entry conditions are locked.
// The organizer can only ask an admin; the change is applied on approval and
// registered players are told. Free events with no prize aren't locked.

enum ChangeKind {
  prize_pool
  cancel
  conditions
  other
}

enum ChangeStatus {
  pending
  approved
  denied
}

model TournamentChangeRequest {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  requestedById String
  kind         ChangeKind
  details      String
  payload      Json?

  status       ChangeStatus @default(pending)
  adminNote    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([tournamentId])
  @@index([status])
}


// Extra awards on top of the placement split (PrizeTier): "Final MVP",
// "Best IGL", "Best rookie"… An award has a cash amount (counts toward the
// prize pool), a non-cash prize, or both. Locked together with the pool once
// players register; changes go through an admin change request.
model PrizeAward {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name       String
  cashAmount Decimal? @db.Decimal(14, 2)
  prizeText  String?
  sortOrder  Int      @default(0)

  // Chosen by the organizer after the event, from the players who took part.
  winnerUserId     String?
  winnerAssignedAt DateTime?
  payout           PrizePayout?

  @@index([tournamentId])
}

enum PlayStyle {
  casual
  competitive
}


// ------------------------------------------------------------
// ORGANIZER IDENTITY VERIFICATION
// ------------------------------------------------------------
// Level 2 of organizer trust (Level 1 = application approved, User.kycStatus).
// An approved identity earns the Verified badge (with a paid plan) and lifts
// the new-organizer starter limits. Clubs do not use this.
//
// What we keep, and why: if an organizer scams people we must be able to report
// them to the authorities, so an APPROVED check keeps the verified full name,
// document number and address (number and address encrypted in detailsEnc) for
// as long as the account exists, plus a KEYED HASH of the number to spot the
// same person behind another account. The photos are the riskiest part: they
// live in the private "identity-documents" bucket and are deleted by a
// scheduled job once the organizer has built a track record (confirmed-paid
// events), at the latest `purgeAfter`, and never while there is a payout
// hold, an active ban or an admin "keep longer". A REJECTED check keeps
// nothing but the hash: the typed details are cleared at the decision and the
// photos go after a few days.

enum IdentityStatus {
  pending
  approved
  rejected
}

enum IdentityDocType {
  nic
  passport
}

model IdentityVerification {
  id          String           @id @default(uuid())
  organizerId String           @unique
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id])

  status  IdentityStatus  @default(pending)
  docType IdentityDocType

  // Typed by the organizer (and checked by the reviewer against the document).
  // Kept after approval, cleared on rejection.
  fullName       String?
  // LEGACY plaintext number from before detailsEnc existed. Never written any
  // more; moved into detailsEnc (and nulled) at the next decision.
  documentNumber String?
  // AES-256-GCM (same key as payout details) of {documentNumber, address}.
  detailsEnc     String?

  // Storage paths in the private bucket; null once purged.
  frontPath  String?
  backPath   String? // NIC only
  selfiePath String?

  // HMAC-SHA256 of the normalised document number (secret in env).
  idNumberHash String?

  over18Confirmed Boolean @default(false)
  attemptCount    Int     @default(1)
  rejectionNote   String?

  // Admin can keep the images longer (dispute, ban evidence).
  retentionHold Boolean   @default(false)
  purgeAfter    DateTime? // set when decided
  purgedAt      DateTime?

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  validUntil   DateTime? // approvals expire; the organizer re-verifies

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([idNumberHash])
  @@index([status, purgeAfter])
}
